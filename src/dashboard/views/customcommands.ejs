<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title }) %>
  <style>
    .command-card {
      transition: all 0.2s ease;
    }
    .command-card:hover {
      border-color: rgb(99 102 241);
    }
    .subcommand-row {
      transition: all 0.15s ease;
    }
    .subcommand-row:hover {
      background-color: rgba(255,255,255,0.03);
    }
    .modal-overlay {
      background-color: rgba(0,0,0,0.7);
    }
    input[type="text"], textarea, select {
      background-color: rgb(24 24 27);
      border: 1px solid rgb(63 63 70);
    }
    input[type="text"]:focus, textarea:focus, select:focus {
      border-color: rgb(99 102 241);
      outline: none;
      box-shadow: 0 0 0 2px rgba(99,102,241,0.3);
    }
  </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen guild-page">
  <%- include('partials/background') %>
  <%- include('partials/navbar', { requiresAuth: true, activePage: 'dashboard' }) %>

  <div class="flex min-h-[calc(100vh-65px)] relative z-10">
    <%- include('partials/sidebar', { activeSection: 'customcommands' }) %>

    <!-- Main Content -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto lg:ml-72">
      <div class="max-w-5xl mx-auto">
        <div class="mb-6 md:mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h1 class="text-xl md:text-2xl font-bold mb-2">⚡ Custom Commands</h1>
            <p class="text-zinc-400 text-sm md:text-base">Create and manage server-specific slash commands with subcommands. Changes require deployment to take effect.</p>
          </div>
          <div class="flex gap-2">
            <button type="button" onclick="showCreateModal()" class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 rounded-lg text-sm font-medium transition flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              New Command
            </button>
            <button type="button" onclick="deployCommands()" class="bg-emerald-600 hover:bg-emerald-700 px-4 py-2.5 rounded-lg text-sm font-medium transition flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
              </svg>
              Deploy to Discord
            </button>
          </div>
        </div>

        <!-- Status Banner -->
        <div id="deployStatus" class="px-4 py-3 rounded-lg text-sm mb-6 hidden"></div>

        <!-- Commands List -->
        <div id="commandsList" class="space-y-4">
          <div class="text-center py-12 text-zinc-400">
            <div class="inline-block w-8 h-8 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin mb-4"></div>
            <p>Loading custom commands...</p>
          </div>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="text-center py-16 hidden">
          <div class="text-6xl mb-4">⚡</div>
          <h3 class="text-xl font-semibold mb-2">No Custom Commands</h3>
          <p class="text-zinc-400 mb-6">Create your first server-specific slash command to get started.</p>
          <button type="button" onclick="showCreateModal()" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2.5 rounded-lg text-sm font-medium transition">
            Create Your First Command
          </button>
        </div>
      </div>
    </main>
  </div>

  <!-- Create/Edit Command Modal -->
  <div id="commandModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div class="modal-overlay absolute inset-0" onclick="closeCommandModal()"></div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-full max-w-lg relative z-10 p-6 max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitle" class="text-lg font-bold mb-4">Create Custom Command</h2>
      <form id="commandForm" class="space-y-4">
        <input type="hidden" id="editCommandId">
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Command Name <span class="text-red-400">*</span></label>
          <input type="text" id="commandName" placeholder="mycommand" maxlength="32" required
            class="w-full px-3 py-2 rounded-lg text-sm text-white placeholder-zinc-500">
          <p class="text-xs text-zinc-600 mt-1">Lowercase, no spaces. Use hyphens or underscores.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Description</label>
          <input type="text" id="commandDescription" placeholder="What does this command do?" maxlength="100"
            class="w-full px-3 py-2 rounded-lg text-sm text-white placeholder-zinc-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Category</label>
          <select id="commandCategory" class="w-full px-3 py-2 rounded-lg text-sm text-white">
            <option value="custom">Custom</option>
            <option value="utility">Utility</option>
            <option value="fun">Fun</option>
            <option value="features">Features</option>
            <option value="moderation">Moderation</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Required Permission</label>
          <select id="commandPermissions" class="w-full px-3 py-2 rounded-lg text-sm text-white">
            <option value="">Everyone (no restriction)</option>
            <option value="0x2000">Moderator (Manage Messages)</option>
            <option value="0x20">Server Manager (Manage Server)</option>
            <option value="0x8">Administrator</option>
            <option value="0x4">Ban Members</option>
            <option value="0x2">Kick Members</option>
            <option value="0x4000000000000000">Moderate Members (Timeout)</option>
          </select>
          <p class="text-xs text-zinc-600 mt-1">Only users with this permission can see and use the command.</p>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 rounded-lg text-sm font-medium transition">
            <span id="modalSubmitText">Create Command</span>
          </button>
          <button type="button" onclick="closeCommandModal()" class="flex-1 bg-zinc-800 hover:bg-zinc-700 px-4 py-2.5 rounded-lg text-sm font-medium transition">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Subcommand Editor Modal -->
  <div id="subcommandModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div class="modal-overlay absolute inset-0" onclick="closeSubcommandModal()"></div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-full max-w-lg relative z-10 p-6 max-h-[90vh] overflow-y-auto">
      <h2 id="subcommandModalTitle" class="text-lg font-bold mb-4">Add Subcommand</h2>
      <form id="subcommandForm" class="space-y-4">
        <input type="hidden" id="editSubcommandIndex">
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Subcommand Name <span class="text-red-400">*</span></label>
          <input type="text" id="subcommandName" placeholder="info" maxlength="32" required
            class="w-full px-3 py-2 rounded-lg text-sm text-white placeholder-zinc-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Description <span class="text-red-400">*</span></label>
          <input type="text" id="subcommandDescription" placeholder="View information" maxlength="100" required
            class="w-full px-3 py-2 rounded-lg text-sm text-white placeholder-zinc-500">
        </div>
        <!-- Message -->
        <div>
          <label class="block text-sm font-medium text-zinc-400 mb-1">Message</label>
          <textarea id="subcommandMessage" rows="3" placeholder="Message content (optional if using an embed)"
            class="w-full px-3 py-2 rounded-lg text-sm text-white placeholder-zinc-500 resize-none"></textarea>
        </div>

        <!-- Embed toggle -->
        <div>
          <label class="flex items-center gap-3 cursor-pointer select-none">
            <input type="checkbox" id="subcommandEmbedEnabled" class="sr-only peer" onchange="toggleSubcommandEmbedFields()">
            <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative"></div>
            <span class="text-sm font-medium">Include an embed</span>
          </label>
        </div>

        <!-- Embed fields (hidden by default) -->
        <div id="subcommandEmbedFields" class="hidden bg-zinc-800/40 rounded-xl p-4 space-y-3 border border-zinc-700">
          <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide mb-2">Embed Options</p>

          <!-- Title + URL -->
          <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" id="subcommandEmbedTitle" placeholder="e.g. 📋 Information"
              class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Title URL <span class="text-xs text-zinc-600 font-normal">(makes title clickable)</span></label>
            <input type="text" id="subcommandEmbedUrl" placeholder="https://…"
              class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Description</label>
            <textarea id="subcommandEmbedDescription" rows="3" placeholder="Main body of the embed…"
              class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition resize-none text-sm"></textarea>
          </div>

          <!-- Color + Timestamp -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Color (hex)</label>
              <input type="text" id="subcommandEmbedColor" placeholder="#5865F2"
                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
            </div>
            <div class="flex items-end pb-2">
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="subcommandEmbedTimestamp" class="sr-only peer">
                <div class="w-10 h-5 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 relative"></div>
                <span class="text-sm font-medium">Timestamp</span>
              </label>
            </div>
          </div>

          <!-- Author -->
          <div class="border-t border-zinc-700 pt-3">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide mb-2">Author</p>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-sm font-medium mb-1">Name</label>
                <input type="text" id="subcommandEmbedAuthorName" placeholder="Author name"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">URL</label>
                <input type="text" id="subcommandEmbedAuthorUrl" placeholder="https://…"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Icon URL</label>
                <input type="text" id="subcommandEmbedAuthorIcon" placeholder="https://…"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
              </div>
            </div>
          </div>

          <!-- Thumbnail + Image -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Thumbnail URL</label>
              <input type="text" id="subcommandEmbedThumbnail" placeholder="https://…"
                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Image URL</label>
              <input type="text" id="subcommandEmbedImage" placeholder="https://…"
                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
            </div>
          </div>

          <!-- Footer -->
          <div class="border-t border-zinc-700 pt-3">
            <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide mb-2">Footer</p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-medium mb-1">Text</label>
                <input type="text" id="subcommandEmbedFooterText" placeholder="Footer text"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Icon URL</label>
                <input type="text" id="subcommandEmbedFooterIcon" placeholder="https://…"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500 transition text-sm">
              </div>
            </div>
          </div>

          <!-- Fields -->
          <div class="border-t border-zinc-700 pt-3">
            <div class="flex items-center justify-between mb-2">
              <p class="text-xs text-zinc-500 font-medium uppercase tracking-wide">Fields</p>
              <button type="button" onclick="addEmbedField()" class="text-xs text-indigo-400 hover:text-indigo-300 transition flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Add
              </button>
            </div>
            <div id="subcommandEmbedFieldsContainer" class="space-y-2"></div>
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 rounded-lg text-sm font-medium transition">
            <span id="subcommandSubmitText">Add Subcommand</span>
          </button>
          <button type="button" onclick="closeSubcommandModal()" class="flex-1 bg-zinc-800 hover:bg-zinc-700 px-4 py-2.5 rounded-lg text-sm font-medium transition">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let customCommands = [];
    let currentCommandId = null;

    // ── Data Loading ──────────────────────────────────────────────────

    // Sanitize name inputs: lowercase, strip invalid chars
    document.addEventListener('DOMContentLoaded', function() {
      function sanitizeNameInput(e) {
        const val = e.target.value;
        // Keep only a-z, 0-9, hyphens, underscores; lowercase
        const cleaned = val.replace(/[^a-zA-Z0-9_-]/g, '').toLowerCase();
        if (cleaned !== val) e.target.value = cleaned;
      }
      const cmdName = document.getElementById('commandName');
      const subName = document.getElementById('subcommandName');
      if (cmdName) cmdName.addEventListener('input', sanitizeNameInput);
      if (subName) subName.addEventListener('input', sanitizeNameInput);
    });

    function onGuildReady(data) {
      document.title = `Custom Commands - ${data.name} - ShaggyBot`;
      loadCommands();
    }

    async function loadCommands() {
      try {
        const res = await fetch(`/api/guilds/${guildId}/custom-commands`);
        if (!res.ok) throw new Error('Failed to load');
        customCommands = await res.json();
        renderCommands();
      } catch (err) {
        document.getElementById('commandsList').innerHTML = `
          <div class="text-center py-12 text-red-400">
            <p>Failed to load custom commands. Please refresh the page.</p>
          </div>`;
      }
    }

    // ── Rendering ─────────────────────────────────────────────────────

    function renderCommands() {
      const container = document.getElementById('commandsList');
      const emptyState = document.getElementById('emptyState');

      if (customCommands.length === 0) {
        container.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      container.innerHTML = customCommands.map(cmd => renderCommandCard(cmd)).join('');
    }

    function renderCommandCard(cmd) {
      const subcommandCount = (cmd.subcommands || []).length;
      const enabledClass = cmd.enabled ? '' : 'opacity-50';

      const permLabels = {
        '0x8': 'Admin Only',
        '0x20': 'Manage Server',
        '0x2000': 'Moderator',
        '0x4': 'Ban Members',
        '0x2': 'Kick Members',
        '0x4000000000000000': 'Moderate Members'
      };
      const permLabel = permLabels[cmd.default_permissions];
      const permBadge = permLabel
        ? '<span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400">' + permLabel + '</span>'
        : '';

      const subcommandList = (cmd.subcommands || []).map((sc, idx) => {
        const hasMessage = !!(sc.message || (sc.response_type === 'text' && sc.response_content));
        const hasEmbed = sc.response_type === 'embed' && sc.response_content;
        const badges = [];
        if (hasMessage) badges.push('<span class="text-xs px-1.5 py-0.5 rounded bg-zinc-700 text-zinc-400">msg</span>');
        if (hasEmbed) badges.push('<span class="text-xs px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-400">embed</span>');
        if (!hasMessage && !hasEmbed) badges.push('<span class="text-xs px-1.5 py-0.5 rounded bg-red-500/20 text-red-400">empty</span>');

        return (
          '<div class="subcommand-row flex items-center justify-between gap-3 px-3 py-2 bg-zinc-800/30 rounded-lg">' +
          '<div class="flex items-center gap-3 min-w-0">' +
          '<code class="text-xs text-indigo-400 font-mono flex-shrink-0">' + escHtml(sc.name) + '</code>' +
          '<span class="text-xs text-zinc-500 truncate">' + escHtml(sc.description || 'No description') + '</span>' +
          '<span class="flex items-center gap-1 flex-shrink-0">' + badges.join('') + '</span>' +
          '</div>' +
          '<div class="flex gap-1 flex-shrink-0">' +
          '<button type="button" onclick="editSubcommand(' + cmd.id + ',' + idx + ')" class="p-1 text-zinc-500 hover:text-indigo-400 transition" title="Edit subcommand">' +
          '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>' +
          '</button>' +
          '<button type="button" onclick="deleteSubcommand(' + cmd.id + ',' + idx + ')" class="p-1 text-zinc-500 hover:text-red-400 transition" title="Delete subcommand">' +
          '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>' +
          '</button>' +
          '</div>' +
          '</div>'
        );
      }).join('');

      return (
        '<div class="command-card bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden ' + enabledClass + '">' +
        '<div class="p-4 flex items-start justify-between gap-4">' +
        '<div class="flex-1 min-w-0">' +
        '<div class="flex items-center gap-3 mb-1">' +
        '<code class="text-lg text-indigo-400 font-mono font-semibold">/' + escHtml(cmd.command_name) + '</code>' +
        '<span class="text-xs px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-500">' + escHtml(cmd.category) + '</span>' +
        permBadge +
        (cmd.enabled ? '' : '<span class="text-xs px-2 py-0.5 rounded-full bg-red-500/20 text-red-400">Disabled</span>') +
        '</div>' +
        '<p class="text-sm text-zinc-400">' + escHtml(cmd.command_description || 'No description') + '</p>' +
        '</div>' +
        '<div class="flex gap-1 flex-shrink-0">' +
        '<button type="button" onclick="showEditModal(' + cmd.id + ')" class="p-2 text-zinc-500 hover:text-indigo-400 transition rounded-lg hover:bg-zinc-800" title="Edit command">' +
        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>' +
        '</button>' +
        '<button type="button" onclick="deleteCommand(' + cmd.id + ')" class="p-2 text-zinc-500 hover:text-red-400 transition rounded-lg hover:bg-zinc-800" title="Delete command">' +
        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>' +
        '</button>' +
        '</div>' +
        '</div>' +
        '<div class="border-t border-zinc-800 px-4 py-3 bg-zinc-900/50">' +
        '<div class="flex items-center justify-between mb-2">' +
        '<h4 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Subcommands (' + subcommandCount + ')</h4>' +
        '<button type="button" onclick="showAddSubcommandModal(' + cmd.id + ')" class="text-xs text-indigo-400 hover:text-indigo-300 transition flex items-center gap-1">' +
        '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Add' +
        '</button>' +
        '</div>' +
        '<div class="space-y-1">' +
        (subcommandList || '<p class="text-xs text-zinc-600 py-2">No subcommands yet. Add one to make this command functional.</p>') +
        '</div>' +
        '</div>' +
        '</div>'
      );
    }

    function escHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Create / Edit Command Modal ────────────────────────────────────

    function showCreateModal() {
      document.getElementById('modalTitle').textContent = 'Create Custom Command';
      document.getElementById('modalSubmitText').textContent = 'Create Command';
      document.getElementById('editCommandId').value = '';
      document.getElementById('commandName').value = '';
      document.getElementById('commandDescription').value = '';
      document.getElementById('commandCategory').value = 'custom';
      document.getElementById('commandPermissions').value = '';
      document.getElementById('commandModal').classList.remove('hidden');
      document.getElementById('commandName').focus();
    }

    function showEditModal(commandId) {
      const cmd = customCommands.find(c => c.id === commandId);
      if (!cmd) return;

      document.getElementById('modalTitle').textContent = 'Edit Command';
      document.getElementById('modalSubmitText').textContent = 'Save Changes';
      document.getElementById('editCommandId').value = cmd.id;
      document.getElementById('commandName').value = cmd.command_name;
      document.getElementById('commandDescription').value = cmd.command_description || '';
      document.getElementById('commandCategory').value = cmd.category || 'custom';
      document.getElementById('commandPermissions').value = cmd.default_permissions || '';
      document.getElementById('commandModal').classList.remove('hidden');
    }

    function closeCommandModal() {
      document.getElementById('commandModal').classList.add('hidden');
    }

    document.getElementById('commandForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = document.getElementById('editCommandId').value;
      const data = {
        command_name: document.getElementById('commandName').value.trim(),
        command_description: document.getElementById('commandDescription').value.trim(),
        category: document.getElementById('commandCategory').value,
        default_permissions: document.getElementById('commandPermissions').value || null
      };

      try {
        let res;
        if (editId) {
          res = await fetch(`/api/guilds/${guildId}/custom-commands/${editId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        } else {
          res = await fetch(`/api/guilds/${guildId}/custom-commands`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        }

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || 'Failed to save');
        }

        closeCommandModal();
        await loadCommands();
        showStatus('✓ Command saved. Deploying to Discord...', 'success');
        try {
          const deployRes = await fetch(`/api/guilds/${guildId}/custom-commands/deploy`, { method: 'POST' });
          const deployData = await deployRes.json();
          if (deployRes.ok) {
            showStatus(`✓ Command saved & deployed (${deployData.dbCommandCount} commands). May take up to a minute to appear.`, 'success');
          } else {
            showStatus('✓ Command saved, but deploy failed: ' + (deployData.error || 'unknown error'), 'error');
          }
        } catch {
          showStatus('✓ Command saved. Click Deploy to Discord to apply changes.', 'success');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    });

    // ── Delete Command ─────────────────────────────────────────────────

    async function deleteCommand(commandId) {
      const cmd = customCommands.find(c => c.id === commandId);
      if (!cmd) return;

      if (!confirm(`Delete /${cmd.command_name} and all its subcommands? This cannot be undone.`)) return;

      try {
        const res = await fetch(`/api/guilds/${guildId}/custom-commands/${commandId}`, { method: 'DELETE' });
        if (!res.ok) throw new Error('Failed to delete');
        await loadCommands();
        showStatus('✓ Command deleted. Removing from Discord...', 'success');
        // Auto-deploy to remove the command from Discord
        await fetch(`/api/guilds/${guildId}/custom-commands/deploy`, { method: 'POST' }).catch(() => {});
        showStatus('✓ Command deleted & removed from Discord.', 'success');
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ── Subcommand Modal ───────────────────────────────────────────────

    function showAddSubcommandModal(commandId) {
      currentCommandId = commandId;
      document.getElementById('subcommandModalTitle').textContent = 'Add Subcommand';
      document.getElementById('subcommandSubmitText').textContent = 'Add Subcommand';
      document.getElementById('editSubcommandIndex').value = '';
      document.getElementById('subcommandName').value = '';
      document.getElementById('subcommandDescription').value = '';
      document.getElementById('subcommandMessage').value = '';
      document.getElementById('subcommandEmbedEnabled').checked = false;
      resetEmbedFields();
      toggleSubcommandEmbedFields();
      document.getElementById('subcommandModal').classList.remove('hidden');
      document.getElementById('subcommandName').focus();
    }

    function resetEmbedFields() {
      document.getElementById('subcommandEmbedTitle').value = '';
      document.getElementById('subcommandEmbedUrl').value = '';
      document.getElementById('subcommandEmbedDescription').value = '';
      document.getElementById('subcommandEmbedColor').value = '';
      document.getElementById('subcommandEmbedTimestamp').checked = false;
      document.getElementById('subcommandEmbedAuthorName').value = '';
      document.getElementById('subcommandEmbedAuthorUrl').value = '';
      document.getElementById('subcommandEmbedAuthorIcon').value = '';
      document.getElementById('subcommandEmbedThumbnail').value = '';
      document.getElementById('subcommandEmbedImage').value = '';
      document.getElementById('subcommandEmbedFooterText').value = '';
      document.getElementById('subcommandEmbedFooterIcon').value = '';
      document.getElementById('subcommandEmbedFieldsContainer').innerHTML = '';
    }

    function editSubcommand(commandId, index) {
      const cmd = customCommands.find(c => c.id === commandId);
      if (!cmd || !cmd.subcommands || !cmd.subcommands[index]) return;

      const sc = cmd.subcommands[index];
      currentCommandId = commandId;
      document.getElementById('subcommandModalTitle').textContent = 'Edit Subcommand';
      document.getElementById('subcommandSubmitText').textContent = 'Save Changes';
      document.getElementById('editSubcommandIndex').value = index;
      document.getElementById('subcommandName').value = sc.name;
      document.getElementById('subcommandDescription').value = sc.description || '';
      document.getElementById('subcommandMessage').value = (sc.response_type === 'text' && !sc.message)
        ? (sc.response_content || '')
        : (sc.message || '');

      const hasEmbed = sc.response_type === 'embed' && sc.response_content;
      document.getElementById('subcommandEmbedEnabled').checked = hasEmbed;
      resetEmbedFields();

      if (hasEmbed) {
        try {
          const embedData = typeof sc.response_content === 'string'
            ? JSON.parse(sc.response_content)
            : sc.response_content;
          document.getElementById('subcommandEmbedTitle').value = embedData.title || '';
          document.getElementById('subcommandEmbedUrl').value = embedData.url || '';
          document.getElementById('subcommandEmbedDescription').value = embedData.description || '';
          document.getElementById('subcommandEmbedColor').value = embedData.color
            ? (typeof embedData.color === 'number' ? '#' + embedData.color.toString(16).padStart(6, '0') : embedData.color)
            : '';
          document.getElementById('subcommandEmbedTimestamp').checked = !!embedData.timestamp;
          document.getElementById('subcommandEmbedAuthorName').value = (embedData.author && embedData.author.name) || '';
          document.getElementById('subcommandEmbedAuthorUrl').value = (embedData.author && embedData.author.url) || '';
          document.getElementById('subcommandEmbedAuthorIcon').value = (embedData.author && embedData.author.icon_url) || '';
          document.getElementById('subcommandEmbedThumbnail').value = (embedData.thumbnail && embedData.thumbnail.url) || '';
          document.getElementById('subcommandEmbedImage').value = (embedData.image && embedData.image.url) || '';
          document.getElementById('subcommandEmbedFooterText').value = (embedData.footer && embedData.footer.text) || '';
          document.getElementById('subcommandEmbedFooterIcon').value = (embedData.footer && embedData.footer.icon_url) || '';

          // Populate fields
          const fields = embedData.fields || [];
          fields.forEach(f => addEmbedField(f.name, f.value, f.inline));
        } catch {
          // If JSON parse fails, just leave embed fields empty
        }
      }

      toggleSubcommandEmbedFields();
      document.getElementById('subcommandModal').classList.remove('hidden');
    }

    function closeSubcommandModal() {
      document.getElementById('subcommandModal').classList.add('hidden');
      currentCommandId = null;
    }

    function toggleSubcommandEmbedFields() {
      const enabled = document.getElementById('subcommandEmbedEnabled').checked;
      document.getElementById('subcommandEmbedFields').classList.toggle('hidden', !enabled);
    }

    document.getElementById('subcommandForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentCommandId) return;

      const cmd = customCommands.find(c => c.id === currentCommandId);
      if (!cmd) return;

      const editIndex = document.getElementById('editSubcommandIndex').value;
      const embedEnabled = document.getElementById('subcommandEmbedEnabled').checked;
      const message = document.getElementById('subcommandMessage').value.trim();

      // Build embed JSON if enabled
      let responseType = 'text';
      let responseContent = message;

      if (embedEnabled) {
        const embedData = {};
        const title = document.getElementById('subcommandEmbedTitle').value.trim();
        const url = document.getElementById('subcommandEmbedUrl').value.trim();
        const description = document.getElementById('subcommandEmbedDescription').value.trim();
        const color = document.getElementById('subcommandEmbedColor').value.trim();
        const timestamp = document.getElementById('subcommandEmbedTimestamp').checked;
        const authorName = document.getElementById('subcommandEmbedAuthorName').value.trim();
        const authorUrl = document.getElementById('subcommandEmbedAuthorUrl').value.trim();
        const authorIcon = document.getElementById('subcommandEmbedAuthorIcon').value.trim();
        const thumbnail = document.getElementById('subcommandEmbedThumbnail').value.trim();
        const image = document.getElementById('subcommandEmbedImage').value.trim();
        const footerText = document.getElementById('subcommandEmbedFooterText').value.trim();
        const footerIcon = document.getElementById('subcommandEmbedFooterIcon').value.trim();

        if (title) embedData.title = title;
        if (url) embedData.url = url;
        if (description) embedData.description = description;
        if (color) embedData.color = parseInt(color.replace('#', ''), 16) || color;
        if (timestamp) embedData.timestamp = new Date().toISOString();
        if (authorName) embedData.author = { name: authorName, ...(authorUrl && { url: authorUrl }), ...(authorIcon && { icon_url: authorIcon }) };
        if (thumbnail) embedData.thumbnail = { url: thumbnail };
        if (image) embedData.image = { url: image };
        if (footerText) embedData.footer = { text: footerText, ...(footerIcon && { icon_url: footerIcon }) };

        // Collect fields
        const fieldRows = document.querySelectorAll('#subcommandEmbedFieldsContainer .embed-field-row');
        const fields = [];
        fieldRows.forEach(row => {
          const nameEl = row.querySelector('.field-name');
          const valueEl = row.querySelector('.field-value');
          const inlineEl = row.querySelector('.field-inline');
          const name = nameEl ? nameEl.value.trim() : '';
          const value = valueEl ? valueEl.value.trim() : '';
          if (name && value) {
            fields.push({ name, value, inline: inlineEl ? inlineEl.checked : false });
          }
        });
        if (fields.length > 0) embedData.fields = fields;

        responseType = 'embed';
        responseContent = JSON.stringify(embedData);
      }

      if (!message && !embedEnabled) {
        alert('Please provide a message or enable the embed.');
        return;
      }

      const subcommand = {
        name: document.getElementById('subcommandName').value.trim(),
        description: document.getElementById('subcommandDescription').value.trim(),
        response_type: responseType,
        response_content: responseContent,
        message: message
      };

      const subcommands = [...(cmd.subcommands || [])];
      if (editIndex !== '') {
        subcommands[parseInt(editIndex)] = subcommand;
      } else {
        subcommands.push(subcommand);
      }

      try {
        const res = await fetch(`/api/guilds/${guildId}/custom-commands/${currentCommandId}/subcommands`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subcommands })
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || 'Failed to save subcommands');
        }

        closeSubcommandModal();
        await loadCommands();
        showStatus('✓ Subcommands saved. Deploying to Discord...', 'success');
        // Auto-deploy so subcommands appear immediately on Discord
        try {
          const deployRes = await fetch(`/api/guilds/${guildId}/custom-commands/deploy`, { method: 'POST' });
          const deployData = await deployRes.json();
          if (deployRes.ok) {
            showStatus(`✓ Subcommands saved & deployed (${deployData.dbCommandCount} commands). May take up to a minute to appear.`, 'success');
          } else {
            showStatus('✓ Subcommands saved, but deploy failed: ' + (deployData.error || 'unknown error'), 'error');
          }
        } catch {
          showStatus('✓ Subcommands saved. Click Deploy to Discord to apply changes.', 'success');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    });

    // ── Dynamic Embed Fields ──────────────────────────────────────────

    function addEmbedField(name, value, inline) {
      const container = document.getElementById('subcommandEmbedFieldsContainer');
      const row = document.createElement('div');
      row.className = 'embed-field-row flex gap-2 items-start bg-zinc-800/50 rounded-lg p-2';
      row.innerHTML =
        '<div class="flex-1 grid grid-cols-2 gap-2">' +
        '<input type="text" class="field-name w-full bg-zinc-800 border border-zinc-700 rounded px-3 py-1.5 text-sm text-white placeholder-zinc-500" placeholder="Field name" value="' + escAttr(name || '') + '">' +
        '<input type="text" class="field-value w-full bg-zinc-800 border border-zinc-700 rounded px-3 py-1.5 text-sm text-white placeholder-zinc-500" placeholder="Field value" value="' + escAttr(value || '') + '">' +
        '</div>' +
        '<label class="flex items-center gap-1.5 cursor-pointer flex-shrink-0 pt-1.5">' +
        '<input type="checkbox" class="field-inline sr-only peer"' + (inline ? ' checked' : '') + '>' +
        '<div class="w-8 h-4 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-indigo-600 relative"></div>' +
        '<span class="text-xs text-zinc-500">Inline</span>' +
        '</label>' +
        '<button type="button" onclick="this.closest(\'.embed-field-row\').remove()" class="p-1 text-zinc-500 hover:text-red-400 transition flex-shrink-0 pt-1.5" title="Remove">' +
        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>' +
        '</button>';
      container.appendChild(row);
    }

    function escAttr(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // ── Delete Subcommand ──────────────────────────────────────────────

    async function deleteSubcommand(commandId, index) {
      const cmd = customCommands.find(c => c.id === commandId);
      if (!cmd) return;

      const sc = cmd.subcommands[index];
      if (!confirm(`Delete subcommand "${sc.name}"?`)) return;

      const subcommands = [...(cmd.subcommands || [])];
      subcommands.splice(index, 1);

      try {
        const res = await fetch(`/api/guilds/${guildId}/custom-commands/${commandId}/subcommands`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subcommands })
        });

        if (!res.ok) throw new Error('Failed to delete subcommand');

        await loadCommands();
        showStatus('✓ Subcommand deleted. Deploy to Discord to apply.', 'success');
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    // ── Deploy to Discord ──────────────────────────────────────────────

    async function deployCommands() {
      const deployBtn = document.querySelector('button[onclick="deployCommands()"]');
      const originalText = deployBtn.innerHTML;
      deployBtn.disabled = true;
      deployBtn.innerHTML = '<div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div> Deploying...';

      try {
        const res = await fetch(`/api/guilds/${guildId}/custom-commands/deploy`, { method: 'POST' });
        const data = await res.json();

        if (res.ok) {
          const dbInfo = data.dbCommandCount > 0
            ? `${data.dbCommandCount} DB command(s)`
            : 'no DB commands';
          showStatus(`✓ Deployed ${data.deployed} command(s) to Discord (${dbInfo}). It may take up to a minute for Discord to update.`, 'success');
        } else {
          throw new Error(data.error || 'Deployment failed');
        }
      } catch (err) {
        showStatus('✗ Deployment failed: ' + err.message, 'error');
      } finally {
        deployBtn.disabled = false;
        deployBtn.innerHTML = originalText;
      }
    }

    // ── Status Messages ────────────────────────────────────────────────

    function showStatus(message, type) {
      const el = document.getElementById('deployStatus');
      el.textContent = message;
      el.className = 'px-4 py-3 rounded-lg text-sm mb-6 ' + (
        type === 'success'
          ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
          : 'bg-red-500/20 text-red-400 border border-red-500/30'
      );
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 5000);
    }

    // ── Keyboard shortcuts ─────────────────────────────────────────────

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeCommandModal();
        closeSubcommandModal();
      }
    });
  </script>

  <%- include('partials/scripts/guild-loader') %>
</body>
</html>
