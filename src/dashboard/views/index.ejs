  <script>
    function onAuthReady(user) {
      document.getElementById('ctaLogin').classList.add('hidden');
      document.getElementById('ctaDashboard').classList.remove('hidden');
    }

    // Fetch bot stats
    fetch('/api/stats').then(r => r.json()).then(data => {
      if (data.guilds) document.getElementById('statServers').textContent = data.guilds.toLocaleString();
      if (data.users) document.getElementById('statUsers').textContent = (data.users / 1000).toFixed(1) + 'K';
    }).catch(() => {
      document.getElementById('statServers').textContent = '2';
      document.getElementById('statUsers').textContent = '100+';
    });
  </script>
  <%- include('partials/scripts/auth-check') %>
