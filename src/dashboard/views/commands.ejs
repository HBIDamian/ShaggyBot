<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Commands' }) %>
  <style>
    .category-gradient {
      background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(99, 102, 241, 0.1), transparent);
    }
    .command-card {
      transition: all 0.2s ease;
    }
    .command-card:hover {
      border-color: rgb(99 102 241 / 0.5);
      transform: translateY(-2px);
    }
    .permission-badge {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(239, 68, 68, 0.1) 100%);
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .option-badge {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.1) 100%);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .required-badge {
      background: linear-gradient(135deg, rgba(234, 179, 8, 0.2) 0%, rgba(234, 179, 8, 0.1) 100%);
      border: 1px solid rgba(234, 179, 8, 0.3);
    }
    .subcommand-card {
      background: linear-gradient(135deg, rgba(39, 39, 42, 0.5) 0%, rgba(24, 24, 27, 0.5) 100%);
    }
    .category-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
    }
    .category-moderation { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
    .category-fun { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    .category-utility { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); }
    .category-features { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); }
    
    /* Tab styling */
    .tab-button {
      transition: all 0.2s ease;
    }
    .tab-button.active {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(99, 102, 241, 0.1) 100%);
      border-color: rgb(99 102 241 / 0.5);
      color: white;
    }
    .tab-button:not(.active):hover {
      background: rgba(63, 63, 70, 0.5);
    }
    
    /* Search highlight */
    .highlight {
      background: rgba(234, 179, 8, 0.3);
      border-radius: 2px;
      padding: 0 2px;
    }
  </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen">
  <%- include('partials/background') %>
  <%- include('partials/navbar') %>

  <main class="p-4 md:p-8 relative z-10 category-gradient min-h-screen">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="mb-8 text-center">
        <h1 class="text-3xl md:text-4xl font-bold mb-3">📚 Bot Commands</h1>
        <p class="text-zinc-400 max-w-2xl mx-auto">Browse all available commands, their usage, and required permissions. Click on a category to explore.</p>
      </div>

      <!-- Search Bar -->
      <div class="mb-6 max-w-xl mx-auto">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search commands..." 
            class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 pl-11 text-white placeholder-zinc-500 focus:outline-none focus:border-indigo-500 transition"
          >
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <button id="clearSearch" class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-white hidden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Category Tabs -->
      <div id="categoryTabs" class="flex flex-wrap justify-center gap-2 mb-8">
        <button class="tab-button active px-4 py-2 rounded-lg border border-zinc-800 text-zinc-300 font-medium" data-category="all">
          All Commands
        </button>
        <!-- Category buttons will be added dynamically -->
      </div>

      <!-- Loading State -->
      <div id="loadingState" class="text-center py-20">
        <div class="inline-block w-8 h-8 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="text-zinc-400">Loading commands...</p>
      </div>

      <!-- Commands Container -->
      <div id="commandsContainer" class="hidden space-y-8">
        <!-- Commands will be rendered here -->
      </div>

      <!-- No Results State -->
      <div id="noResults" class="hidden text-center py-20">
        <div class="text-6xl mb-4">🔍</div>
        <h3 class="text-xl font-semibold mb-2">No commands found</h3>
        <p class="text-zinc-400">Try a different search term or category</p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    const categoryIcons = {
      moderation: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
      fun: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
      utility: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
      features: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
    };

    const categoryDescriptions = {
      moderation: 'Tools for server moderation and member management',
      fun: 'Entertainment and interactive commands',
      utility: 'Helpful utility commands and information',
      features: 'Server feature management commands'
    };

    let allCommands = {};
    let currentCategory = 'all';
    let searchQuery = '';

    // Fetch commands from API
    async function fetchCommands() {
      try {
        const res = await fetch('/api/commands');
        allCommands = await res.json();
        renderCategoryTabs();
        renderCommands();
      } catch (err) {
        console.error('Failed to load commands:', err);
        document.getElementById('loadingState').innerHTML = `
          <div class="text-red-500 text-6xl mb-4">⚠️</div>
          <p class="text-zinc-400">Failed to load commands. Please try again later.</p>
        `;
      }
    }

    // Render category tabs
    function renderCategoryTabs() {
      const tabsContainer = document.getElementById('categoryTabs');
      const categories = Object.keys(allCommands);
      
      categories.forEach(category => {
        const btn = document.createElement('button');
        btn.className = 'tab-button px-4 py-2 rounded-lg border border-zinc-800 text-zinc-300 font-medium flex items-center gap-2';
        btn.dataset.category = category;
        btn.innerHTML = `
          <span class="category-icon category-${category} !w-6 !h-6 !rounded-md">${categoryIcons[category] || ''}</span>
          ${capitalize(category)}
          <span class="text-xs bg-zinc-800 px-1.5 py-0.5 rounded">${allCommands[category].length}</span>
        `;
        btn.addEventListener('click', () => selectCategory(category));
        tabsContainer.appendChild(btn);
      });
    }

    // Select category
    function selectCategory(category) {
      currentCategory = category;
      document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.category === category);
      });
      renderCommands();
    }

    // Render commands
    function renderCommands() {
      const container = document.getElementById('commandsContainer');
      const loadingState = document.getElementById('loadingState');
      const noResults = document.getElementById('noResults');
      
      loadingState.classList.add('hidden');
      container.classList.remove('hidden');
      container.innerHTML = '';

      const categoriesToRender = currentCategory === 'all' 
        ? Object.keys(allCommands) 
        : [currentCategory];

      let totalMatches = 0;

      categoriesToRender.forEach(category => {
        const commands = filterCommands(allCommands[category]);
        if (commands.length === 0) return;
        totalMatches += commands.length;

        const section = document.createElement('div');
        section.className = 'category-section';
        section.innerHTML = `
          <div class="flex items-center gap-3 mb-4">
            <div class="category-icon category-${category}">${categoryIcons[category] || ''}</div>
            <div>
              <h2 class="text-xl font-bold">${capitalize(category)}</h2>
              <p class="text-zinc-500 text-sm">${categoryDescriptions[category] || ''}</p>
            </div>
            <span class="ml-auto text-zinc-500 text-sm">${commands.length} command${commands.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            ${commands.map(cmd => renderCommandCard(cmd)).join('')}
          </div>
        `;
        container.appendChild(section);
      });

      noResults.classList.toggle('hidden', totalMatches > 0);
      container.classList.toggle('hidden', totalMatches === 0);
    }

    // Filter commands based on search
    function filterCommands(commands) {
      if (!searchQuery) return commands;
      const query = searchQuery.toLowerCase();
      return commands.filter(cmd => 
        cmd.name.toLowerCase().includes(query) ||
        cmd.description.toLowerCase().includes(query) ||
        cmd.subcommands?.some(sub => 
          sub.name.toLowerCase().includes(query) || 
          sub.description.toLowerCase().includes(query)
        )
      );
    }

    // Highlight search matches
    function highlightMatch(text) {
      if (!searchQuery) return text;
      const regex = new RegExp(`(${escapeRegex(searchQuery)})`, 'gi');
      return text.replace(regex, '<span class="highlight">$1</span>');
    }

    function escapeRegex(str) {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // Render a single command card
    function renderCommandCard(cmd) {
      const hasSubcommands = cmd.subcommands?.length > 0 || cmd.subcommandGroups?.length > 0;
      const hasOptions = cmd.options?.length > 0;
      const hasPermissions = cmd.permissions?.length > 0;

      let usageExample = `/${cmd.name}`;
      if (hasSubcommands) {
        usageExample += ` <subcommand>`;
      } else if (hasOptions) {
        cmd.options.forEach(opt => {
          usageExample += opt.required ? ` <${opt.name}>` : ` [${opt.name}]`;
        });
      }

      return `
        <div class="command-card bg-zinc-900 border border-zinc-800 rounded-xl p-5">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <h3 class="font-bold text-lg text-white">/${highlightMatch(cmd.name)}</h3>
              <p class="text-zinc-400 text-sm mt-1">${highlightMatch(cmd.description)}</p>
            </div>
          </div>

          <!-- Usage -->
          <div class="mb-3">
            <div class="text-xs text-zinc-500 uppercase tracking-wider mb-1">Usage</div>
            <code class="block bg-zinc-800 px-3 py-2 rounded-lg text-sm text-indigo-400 font-mono">${usageExample}</code>
          </div>

          ${hasPermissions ? `
            <div class="mb-3">
              <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">Required Permissions</div>
              <div class="flex flex-wrap gap-1.5">
                ${cmd.permissions.map(perm => `
                  <span class="permission-badge text-red-400 text-xs px-2 py-1 rounded-md">${perm}</span>
                `).join('')}
              </div>
            </div>
          ` : ''}

          ${hasOptions ? `
            <div class="mb-3">
              <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">Options</div>
              <div class="space-y-2">
                ${cmd.options.map(opt => renderOption(opt)).join('')}
              </div>
            </div>
          ` : ''}

          ${hasSubcommands ? `
            <div>
              <div class="text-xs text-zinc-500 uppercase tracking-wider mb-2">Subcommands</div>
              <div class="space-y-2">
                ${cmd.subcommands.map(sub => renderSubcommand(cmd.name, sub)).join('')}
              </div>
              ${cmd.subcommandGroups?.map(group => `
                <div class="mt-3">
                  <div class="text-xs text-zinc-400 mb-2">${group.name}</div>
                  <div class="space-y-2">
                    ${group.subcommands.map(sub => renderSubcommand(cmd.name, sub, group.name)).join('')}
                  </div>
                </div>
              `).join('') || ''}
            </div>
          ` : ''}
        </div>
      `;
    }

    // Render option
    function renderOption(opt) {
      return `
        <div class="flex items-start gap-2 text-sm">
          <span class="option-badge text-blue-400 text-xs px-2 py-0.5 rounded font-mono">${opt.name}</span>
          ${opt.required ? '<span class="required-badge text-yellow-400 text-xs px-1.5 py-0.5 rounded">required</span>' : ''}
          <span class="text-zinc-400 flex-1">${opt.description}</span>
          <span class="text-zinc-600 text-xs">${opt.type}</span>
        </div>
      `;
    }

    // Render subcommand
    function renderSubcommand(parentName, sub, groupName = null) {
      const fullCommand = groupName 
        ? `/${parentName} ${groupName} ${sub.name}`
        : `/${parentName} ${sub.name}`;
      
      let usage = fullCommand;
      if (sub.options?.length > 0) {
        sub.options.forEach(opt => {
          usage += opt.required ? ` <${opt.name}>` : ` [${opt.name}]`;
        });
      }

      return `
        <div class="subcommand-card rounded-lg p-3 border border-zinc-800">
          <div class="flex items-center gap-2 mb-1">
            <code class="text-indigo-400 text-sm font-mono">${highlightMatch(sub.name)}</code>
          </div>
          <p class="text-zinc-400 text-xs mb-2">${highlightMatch(sub.description)}</p>
          <code class="block bg-zinc-900 px-2 py-1 rounded text-xs text-zinc-500 font-mono">${usage}</code>
          ${sub.options?.length > 0 ? `
            <div class="mt-2 space-y-1">
              ${sub.options.map(opt => `
                <div class="flex items-center gap-1.5 text-xs">
                  <span class="option-badge text-blue-400 px-1.5 py-0.5 rounded font-mono">${opt.name}</span>
                  ${opt.required ? '<span class="required-badge text-yellow-400 px-1 py-0.5 rounded">req</span>' : ''}
                  <span class="text-zinc-500">${opt.type}</span>
                </div>
              `).join('')}
            </div>
          ` : ''}
        </div>
      `;
    }

    // Utility
    function capitalize(str) {
      return str.charAt(0).toUpperCase() + str.slice(1);
    }

    // Event Listeners
    document.getElementById('searchInput').addEventListener('input', (e) => {
      searchQuery = e.target.value.trim();
      document.getElementById('clearSearch').classList.toggle('hidden', !searchQuery);
      renderCommands();
    });

    document.getElementById('clearSearch').addEventListener('click', () => {
      document.getElementById('searchInput').value = '';
      searchQuery = '';
      document.getElementById('clearSearch').classList.add('hidden');
      renderCommands();
    });

    document.querySelector('[data-category="all"]').addEventListener('click', () => selectCategory('all'));

    // Initialize
    fetchCommands();
  </script>
</body>
</html>
