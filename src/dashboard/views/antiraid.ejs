                  <div class="space-y-3">
                    <div>
                      <label class="block text-sm font-medium mb-1">Action:</label>
                      <select id="no_avatar_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
                        <option value="flag">Flag Only (Log)</option>
                        <option value="kick" selected>Kick</option>
                        <option value="ban">Ban</option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-sm font-medium mb-1">Notification Channel:</label>
                      <select id="no_avatar_channel" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 channel-select">
                        <option value="">None</option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-sm font-medium mb-1">Role Ping:</label>
                      <select id="no_avatar_role_ping" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 role-select">
                        <option value="">None</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Unverified Email Card -->
              <div class="bg-zinc-800 rounded-xl border border-zinc-700 overflow-hidden">
                <div class="p-5">
                  <h3 class="text-lg font-semibold text-center mb-4">Unverified Email</h3>
                  <p class="text-xs text-zinc-500 text-center mb-4">Flag accounts without a verified email address</p>
                  
                  <div class="flex items-center justify-center gap-2 mb-4">
                    <span class="text-sm">Enable Feature</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="unverified_email_enabled" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                  </div>

                  <div class="space-y-3">
                    <div>
                      <label class="block text-sm font-medium mb-1">Action:</label>
                      <select id="unverified_email_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
                        <option value="flag">Flag Only (Log)</option>
                        <option value="kick" selected>Kick</option>
                        <option value="ban">Ban</option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-sm font-medium mb-1">Notification Channel:</label>
                      <select id="unverified_email_channel" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 channel-select">
                        <option value="">None</option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-sm font-medium mb-1">Role Ping:</label>
                      <select id="unverified_email_role_ping" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 role-select">
                        <option value="">None</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Actions - Desktop -->
          <div class="hidden md:flex gap-4">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2.5 rounded-lg font-medium transition">
              Save Changes
            </button>
            <button type="button" onclick="loadSettings()" class="bg-zinc-800 hover:bg-zinc-700 px-6 py-2.5 rounded-lg font-medium transition">
              Reset
            </button>
          </div>
        </form>

        <div id="saveStatus" class="mt-4 px-4 py-3 rounded-lg text-sm hidden"></div>
      </div>
    </main>
  </div>

  <!-- Mobile Fixed Save Bar -->
  <div class="fixed bottom-0 left-0 right-0 bg-zinc-900 border-t border-zinc-800 p-4 flex gap-3 md:hidden z-50">
    <button type="button" onclick="document.getElementById('antiRaidForm').dispatchEvent(new Event('submit', {cancelable: true, bubbles: true}))" class="flex-1 bg-indigo-600 hover:bg-indigo-700 px-4 py-3 rounded-lg font-medium transition">
      Save Changes
    </button>
    <button type="button" onclick="loadSettings()" class="bg-zinc-800 hover:bg-zinc-700 px-4 py-3 rounded-lg font-medium transition">
      Reset
    </button>
  </div>
  <div class="h-20 md:hidden"></div>

  <script>
    function toggleCategory(categoryId) {
      const content = document.getElementById(`category-${categoryId}`);
      const chevron = document.getElementById(`chevron-${categoryId}`);
      content.classList.toggle('open');
      chevron.classList.toggle('open');
    }

    function onGuildReady(data) {
      document.title = `Anti-Raid - ${data.name} - ShaggyBot`;

      // Populate channel selects
      document.querySelectorAll('.channel-select').forEach(select => {
        data.channels.forEach(channel => {
          const option = document.createElement('option');
          option.value = channel.id;
          option.textContent = `#${channel.name}`;
          select.appendChild(option);
        });
      });

      // Populate role selects
      document.querySelectorAll('.role-select').forEach(select => {
        data.roles.forEach(role => {
          const option = document.createElement('option');
          option.value = role.id;
          option.textContent = `@${role.name}`;
          select.appendChild(option);
        });
      });

      // Initialize multi-selects after options are populated
      initMultiSelects();

      loadSettings();
    }

    function loadSettings() {
      fetch(`/api/guilds/${guildId}/antiraid`).then(res => res.json()).then(settings => {
        // Master switch
        document.getElementById('masterEnabled').checked = settings.enabled;

        // Mass Joins
        document.getElementById('mass_joins_enabled').checked = settings.mass_joins_enabled;
        document.getElementById('mass_joins_ban_users').checked = settings.mass_joins_ban_users;
        document.getElementById('mass_joins_time_limit').value = settings.mass_joins_time_limit || 15;
        document.getElementById('mass_joins_user_limit').value = settings.mass_joins_user_limit || 4;
        document.getElementById('mass_joins_pause_duration').value = settings.mass_joins_pause_duration || '2 Hours';
        document.getElementById('mass_joins_channel').value = settings.mass_joins_channel || '';
        document.getElementById('mass_joins_role_ping').value = settings.mass_joins_role_ping || '';

        // Same Account Creation Time
        document.getElementById('same_account_enabled').checked = settings.same_account_enabled;
        document.getElementById('same_account_ban_users').checked = settings.same_account_ban_users;
        document.getElementById('same_account_time_limit').value = settings.same_account_time_limit || 10;
        document.getElementById('same_account_user_limit').value = settings.same_account_user_limit || 4;
        document.getElementById('same_account_percentage').value = settings.same_account_percentage || 51;
        document.getElementById('same_account_pause_duration').value = settings.same_account_pause_duration || '2 Hours';
        document.getElementById('same_account_channel').value = settings.same_account_channel || '';
        document.getElementById('same_account_role_ping').value = settings.same_account_role_ping || '';

        // Message Spam
        document.getElementById('message_spam_enabled').checked = settings.message_spam_enabled;
        document.getElementById('message_spam_ban_users').checked = settings.message_spam_ban_users;
        document.getElementById('message_spam_time_limit').value = settings.message_spam_time_limit || 10;
        document.getElementById('message_spam_message_limit').value = settings.message_spam_message_limit || 10;
        document.getElementById('message_spam_timeout_duration').value = settings.message_spam_timeout_duration || '6 Hours';
        document.getElementById('message_spam_channel').value = settings.message_spam_channel || '';
        document.getElementById('message_spam_role_ping').value = settings.message_spam_role_ping || '';
        setMultiSelect('message_spam_ignored_roles', settings.message_spam_ignored_roles || []);
        setMultiSelect('message_spam_ignored_channels', settings.message_spam_ignored_channels || []);

        // Other Checks
        document.getElementById('other_checks_enabled').checked = settings.other_checks_enabled;
        document.getElementById('other_checks_ban_users').checked = settings.other_checks_ban_users;
        document.getElementById('other_checks_similarity_limit').value = settings.other_checks_similarity_limit || 5;
        document.getElementById('other_checks_fuzzy_score').value = settings.other_checks_fuzzy_score || 200;
        document.getElementById('other_checks_mention_limit').value = settings.other_checks_mention_limit || 4;
        document.getElementById('other_checks_timeout_duration').value = settings.other_checks_timeout_duration || '6 Hours';
        document.getElementById('other_checks_channel').value = settings.other_checks_channel || '';
        document.getElementById('other_checks_role_ping').value = settings.other_checks_role_ping || '';
        setMultiSelect('other_checks_ignored_roles', settings.other_checks_ignored_roles || []);
        setMultiSelect('other_checks_ignored_channels', settings.other_checks_ignored_channels || []);

        // Security Checks - No Avatar
        document.getElementById('no_avatar_enabled').checked = settings.no_avatar_enabled;
        document.getElementById('no_avatar_action').value = settings.no_avatar_action || 'kick';
        document.getElementById('no_avatar_channel').value = settings.no_avatar_channel || '';
        document.getElementById('no_avatar_role_ping').value = settings.no_avatar_role_ping || '';

        // Security Checks - Unverified Email
        document.getElementById('unverified_email_enabled').checked = settings.unverified_email_enabled;
        document.getElementById('unverified_email_action').value = settings.unverified_email_action || 'kick';
        document.getElementById('unverified_email_channel').value = settings.unverified_email_channel || '';
        document.getElementById('unverified_email_role_ping').value = settings.unverified_email_role_ping || '';
      }).catch(err => {
        console.error('Failed to load settings:', err);
      });
    }

    function setMultiSelect(id, values) {
      const select = document.getElementById(id);
      if (!select) return;
      
      if (select.multiSelect) {
        select.multiSelect.setValues(values || []);
      } else {
        Array.from(select.options).forEach(option => {
          option.selected = values.includes(option.value);
        });
      }
    }

    function getMultiSelect(id) {
      const select = document.getElementById(id);
      if (!select) return [];
      
      if (select.multiSelect) {
        return select.multiSelect.getValues();
      }
      return Array.from(select.selectedOptions).map(o => o.value);
    }

    document.getElementById('antiRaidForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const data = {
        // Master switch
        enabled: document.getElementById('masterEnabled').checked ? 1 : 0,

        // Mass Joins
        mass_joins_enabled: document.getElementById('mass_joins_enabled').checked ? 1 : 0,
        mass_joins_ban_users: document.getElementById('mass_joins_ban_users').checked ? 1 : 0,
        mass_joins_time_limit: parseInt(document.getElementById('mass_joins_time_limit').value) || 15,
        mass_joins_user_limit: parseInt(document.getElementById('mass_joins_user_limit').value) || 4,
        mass_joins_pause_duration: document.getElementById('mass_joins_pause_duration').value,
        mass_joins_channel: document.getElementById('mass_joins_channel').value,
        mass_joins_role_ping: document.getElementById('mass_joins_role_ping').value,

        // Same Account Creation Time
        same_account_enabled: document.getElementById('same_account_enabled').checked ? 1 : 0,
        same_account_ban_users: document.getElementById('same_account_ban_users').checked ? 1 : 0,
        same_account_time_limit: parseInt(document.getElementById('same_account_time_limit').value) || 10,
        same_account_user_limit: parseInt(document.getElementById('same_account_user_limit').value) || 4,
        same_account_percentage: parseInt(document.getElementById('same_account_percentage').value) || 51,
        same_account_pause_duration: document.getElementById('same_account_pause_duration').value,
        same_account_channel: document.getElementById('same_account_channel').value,
        same_account_role_ping: document.getElementById('same_account_role_ping').value,

        // Message Spam
        message_spam_enabled: document.getElementById('message_spam_enabled').checked ? 1 : 0,
        message_spam_ban_users: document.getElementById('message_spam_ban_users').checked ? 1 : 0,
        message_spam_time_limit: parseInt(document.getElementById('message_spam_time_limit').value) || 10,
        message_spam_message_limit: parseInt(document.getElementById('message_spam_message_limit').value) || 10,
        message_spam_timeout_duration: document.getElementById('message_spam_timeout_duration').value,
        message_spam_channel: document.getElementById('message_spam_channel').value,
        message_spam_role_ping: document.getElementById('message_spam_role_ping').value,
        message_spam_ignored_roles: getMultiSelect('message_spam_ignored_roles'),
        message_spam_ignored_channels: getMultiSelect('message_spam_ignored_channels'),

        // Other Checks
        other_checks_enabled: document.getElementById('other_checks_enabled').checked ? 1 : 0,
        other_checks_ban_users: document.getElementById('other_checks_ban_users').checked ? 1 : 0,
        other_checks_similarity_limit: parseInt(document.getElementById('other_checks_similarity_limit').value) || 5,
        other_checks_fuzzy_score: parseInt(document.getElementById('other_checks_fuzzy_score').value) || 200,
        other_checks_mention_limit: parseInt(document.getElementById('other_checks_mention_limit').value) || 4,
        other_checks_timeout_duration: document.getElementById('other_checks_timeout_duration').value,
        other_checks_channel: document.getElementById('other_checks_channel').value,
        other_checks_role_ping: document.getElementById('other_checks_role_ping').value,
        other_checks_ignored_roles: getMultiSelect('other_checks_ignored_roles'),
        other_checks_ignored_channels: getMultiSelect('other_checks_ignored_channels'),

        // Security Checks - No Avatar
        no_avatar_enabled: document.getElementById('no_avatar_enabled').checked ? 1 : 0,
        no_avatar_action: document.getElementById('no_avatar_action').value,
        no_avatar_channel: document.getElementById('no_avatar_channel').value,
        no_avatar_role_ping: document.getElementById('no_avatar_role_ping').value,

        // Security Checks - Unverified Email
        unverified_email_enabled: document.getElementById('unverified_email_enabled').checked ? 1 : 0,
        unverified_email_action: document.getElementById('unverified_email_action').value,
        unverified_email_channel: document.getElementById('unverified_email_channel').value,
        unverified_email_role_ping: document.getElementById('unverified_email_role_ping').value
      };

      const status = document.getElementById('saveStatus');
      status.textContent = 'Saving...';
      status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-zinc-800 text-zinc-400';

      try {
        const res = await fetch(`/api/guilds/${guildId}/antiraid`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          status.textContent = '✓ Anti-raid settings saved successfully!';
          status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-green-500/20 text-green-400';
        } else throw new Error('Failed');
      } catch {
        status.textContent = '✗ Failed to save settings. Please try again.';
        status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-red-500/20 text-red-400';
      }
      setTimeout(() => { status.className = 'mt-4 px-4 py-3 rounded-lg text-sm hidden'; }, 3000);
    });
  </script>
  <%- include('partials/scripts/guild-loader') %>
  <%- include('partials/scripts/multi-select') %>
</body>
</html>
