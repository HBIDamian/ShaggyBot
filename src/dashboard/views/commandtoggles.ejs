<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title }) %>
  <style>
    .command-toggle-card {
      transition: all 0.2s ease;
    }
    .command-toggle-card:hover {
      border-color: rgb(63 63 70);
    }
    .command-toggle-card.disabled {
      opacity: 0.6;
    }
    .category-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgb(9 9 11);
    }
  </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen guild-page">
  <%- include('partials/background') %>
  <%- include('partials/navbar', { requiresAuth: true, activePage: 'dashboard' }) %>

  <div class="flex min-h-[calc(100vh-65px)] relative z-10">
    <%- include('partials/sidebar', { activeSection: 'commandtoggles' }) %>

    <!-- Main Content -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto lg:ml-72">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6 md:mb-8">
          <h1 class="text-xl md:text-2xl font-bold mb-2">🎚️ Command Toggles</h1>
          <p class="text-zinc-400 text-sm md:text-base">Enable or disable public-facing commands for your server. Moderation commands cannot be disabled.</p>
        </div>

        <!-- Info Banner -->
        <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-6 flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="text-sm text-amber-200 font-medium">Note about disabled commands</p>
            <p class="text-xs text-amber-200/70 mt-1">Disabled commands will show an error message to users. Admins and mods can still use them based on the bypass settings below.</p>
          </div>
        </div>

        <form id="commandTogglesForm" class="space-y-6">
          <!-- Bypass Settings -->
          <div class="bg-indigo-600/20 border border-indigo-500 p-6 rounded-xl">
            <h3 class="font-semibold text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              Bypass Settings
            </h3>
            <p class="text-sm text-zinc-400 mb-4">Allow certain roles to use disabled commands regardless of the toggles below.</p>
            
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4 p-4 bg-zinc-900/50 rounded-lg">
                <div>
                  <span class="text-sm font-medium">Administrators Bypass</span>
                  <p class="text-xs text-zinc-500 mt-1">Users with Administrator permission can use all commands</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="admins_bypass" checked class="sr-only peer">
                  <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>

              <div class="flex items-center justify-between gap-4 p-4 bg-zinc-900/50 rounded-lg">
                <div>
                  <span class="text-sm font-medium">Moderators Bypass</span>
                  <p class="text-xs text-zinc-500 mt-1">Users with Manage Messages permission can use all commands</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="mods_bypass" checked class="sr-only peer">
                  <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="bg-zinc-900 p-4 rounded-xl border border-zinc-800 flex flex-wrap gap-3">
            <button type="button" onclick="enableAllCommands()" class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Enable All
            </button>
            <button type="button" onclick="disableAllCommands()" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              Disable All
            </button>
            <div class="flex-1"></div>
            <span id="commandCount" class="text-sm text-zinc-500 self-center"></span>
          </div>

          <!-- Commands by Category -->
          <div id="commandsContainer" class="space-y-6">
            <div class="text-center py-12 text-zinc-400">
              <div class="inline-block w-8 h-8 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin mb-4"></div>
              <p>Loading commands...</p>
            </div>
          </div>

          <!-- Actions - Desktop -->
          <div class="hidden md:flex gap-4">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2.5 rounded-lg font-medium transition">
              Save Changes
            </button>
            <button type="button" onclick="loadSettings()" class="bg-zinc-800 hover:bg-zinc-700 px-6 py-2.5 rounded-lg font-medium transition">
              Reset
            </button>
          </div>
        </form>

        <div id="saveStatus" class="mt-4 px-4 py-3 rounded-lg text-sm hidden"></div>
      </div>
    </main>
  </div>

  <!-- Mobile Fixed Save Bar -->
  <div class="fixed bottom-0 left-0 right-0 bg-zinc-900 border-t border-zinc-800 p-4 flex gap-3 md:hidden z-50">
    <button type="button" onclick="document.getElementById('commandTogglesForm').dispatchEvent(new Event('submit', {cancelable: true, bubbles: true}))" class="flex-1 bg-indigo-600 hover:bg-indigo-700 px-4 py-3 rounded-lg font-medium transition">
      Save Changes
    </button>
    <button type="button" onclick="loadSettings()" class="bg-zinc-800 hover:bg-zinc-700 px-4 py-3 rounded-lg font-medium transition">
      Reset
    </button>
  </div>
  <div class="h-20 md:hidden"></div>

  <script>
    let allCommands = {};
    let disabledCommands = [];
    
    // Categories that contain public commands (exclude moderation)
    const publicCategories = ['fun', 'utility', 'features'];
    
    const categoryInfo = {
      fun: { icon: '🎮', name: 'Fun', description: 'Entertainment and interactive commands' },
      utility: { icon: '🔧', name: 'Utility', description: 'Helpful utility commands' },
      features: { icon: '✨', name: 'Features', description: 'Server feature commands' }
    };

    function onGuildReady(data) {
      document.title = `Command Toggles - ${data.name} - ShaggyBot`;
      loadCommands();
    }

    async function loadCommands() {
      try {
        const res = await fetch('/api/commands');
        allCommands = await res.json();
        await loadSettings();
      } catch (err) {
        console.error('Failed to load commands:', err);
        document.getElementById('commandsContainer').innerHTML = `
          <div class="text-center py-12 text-red-400">
            <p>Failed to load commands. Please refresh the page.</p>
          </div>
        `;
      }
    }

    async function loadSettings() {
      try {
        const res = await fetch(`/api/guilds/${guildId}/commandtoggles`);
        const settings = await res.json();
        
        document.getElementById('admins_bypass').checked = settings.admins_bypass;
        document.getElementById('mods_bypass').checked = settings.mods_bypass;
        disabledCommands = settings.disabled_commands || [];
        
        renderCommands();
      } catch (err) {
        console.error('Failed to load settings:', err);
      }
    }

    function renderCommands() {
      const container = document.getElementById('commandsContainer');
      container.innerHTML = '';
      
      let totalCommands = 0;
      let enabledCount = 0;

      publicCategories.forEach(category => {
        const commands = allCommands[category];
        if (!commands || commands.length === 0) return;

        const info = categoryInfo[category];
        const section = document.createElement('div');
        section.className = 'bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden';
        
        section.innerHTML = `
          <div class="category-header p-4 border-b border-zinc-800 bg-zinc-900">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">${info.icon}</span>
                <div>
                  <h3 class="font-semibold">${info.name}</h3>
                  <p class="text-xs text-zinc-500">${info.description}</p>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" onclick="toggleCategory('${category}', true)" class="text-xs bg-green-600/20 text-green-400 hover:bg-green-600/30 px-2 py-1 rounded transition">Enable All</button>
                <button type="button" onclick="toggleCategory('${category}', false)" class="text-xs bg-red-600/20 text-red-400 hover:bg-red-600/30 px-2 py-1 rounded transition">Disable All</button>
              </div>
            </div>
          </div>
          <div class="p-4 grid gap-3" id="category-${category}">
            ${commands.map(cmd => {
              const isEnabled = !disabledCommands.includes(cmd.name);
              totalCommands++;
              if (isEnabled) enabledCount++;
              return renderCommandCard(cmd, isEnabled);
            }).join('')}
          </div>
        `;
        
        container.appendChild(section);
      });

      document.getElementById('commandCount').textContent = `${enabledCount}/${totalCommands} commands enabled`;
    }

    function renderCommandCard(cmd, isEnabled) {
      const hasSubcommands = cmd.subcommands?.length > 0;
      const subcommandText = hasSubcommands ? `<span class="text-xs text-zinc-600 ml-2">${cmd.subcommands.length} subcommands</span>` : '';
      
      return `
        <div class="command-toggle-card flex items-center justify-between gap-4 p-3 bg-zinc-800/50 rounded-lg border border-zinc-800 ${isEnabled ? '' : 'disabled'}" data-command="${cmd.name}">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <code class="text-indigo-400 font-mono text-sm">/${cmd.name}</code>
              ${subcommandText}
            </div>
            <p class="text-xs text-zinc-500 mt-1 truncate">${cmd.description}</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
            <input type="checkbox" class="sr-only peer command-toggle" data-command="${cmd.name}" ${isEnabled ? 'checked' : ''} onchange="toggleCommand('${cmd.name}', this.checked)">
            <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-600"></div>
          </label>
        </div>
      `;
    }

    function toggleCommand(commandName, enabled) {
      const card = document.querySelector(`[data-command="${commandName}"]`);
      
      if (enabled) {
        disabledCommands = disabledCommands.filter(c => c !== commandName);
        card?.classList.remove('disabled');
      } else {
        if (!disabledCommands.includes(commandName)) {
          disabledCommands.push(commandName);
        }
        card?.classList.add('disabled');
      }
      
      updateCommandCount();
    }

    function toggleCategory(category, enable) {
      const commands = allCommands[category] || [];
      commands.forEach(cmd => {
        const checkbox = document.querySelector(`input[data-command="${cmd.name}"]`);
        if (checkbox) {
          checkbox.checked = enable;
          toggleCommand(cmd.name, enable);
        }
      });
    }

    function enableAllCommands() {
      publicCategories.forEach(cat => toggleCategory(cat, true));
    }

    function disableAllCommands() {
      publicCategories.forEach(cat => toggleCategory(cat, false));
    }

    function updateCommandCount() {
      let total = 0;
      let enabled = 0;
      publicCategories.forEach(cat => {
        const commands = allCommands[cat] || [];
        total += commands.length;
        commands.forEach(cmd => {
          if (!disabledCommands.includes(cmd.name)) enabled++;
        });
      });
      document.getElementById('commandCount').textContent = `${enabled}/${total} commands enabled`;
    }

    // Form submission
    document.getElementById('commandTogglesForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const saveStatus = document.getElementById('saveStatus');
      
      try {
        const res = await fetch(`/api/guilds/${guildId}/commandtoggles`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            admins_bypass: document.getElementById('admins_bypass').checked ? 1 : 0,
            mods_bypass: document.getElementById('mods_bypass').checked ? 1 : 0,
            disabled_commands: disabledCommands
          })
        });

        if (res.ok) {
          saveStatus.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-green-500/20 text-green-400 border border-green-500/30';
          saveStatus.textContent = '✓ Settings saved successfully!';
          saveStatus.classList.remove('hidden');
        } else {
          throw new Error('Failed to save');
        }
      } catch (err) {
        saveStatus.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-red-500/20 text-red-400 border border-red-500/30';
        saveStatus.textContent = '✗ Failed to save settings. Please try again.';
        saveStatus.classList.remove('hidden');
      }

      setTimeout(() => saveStatus.classList.add('hidden'), 3000);
    });
  </script>

  <%- include('partials/scripts/guild-loader') %>
</body>
</html>
