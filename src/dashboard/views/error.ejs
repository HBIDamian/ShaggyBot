<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title || 'Error' }) %>
</head>
<body class="bg-zinc-950 text-white min-h-screen">
  <%- include('partials/background') %>
  <%- include('partials/navbar', { activePage: '' }) %>

  <main class="min-h-[calc(100vh-65px)] flex items-center justify-center text-center px-6 relative z-10">
    <div class="max-w-lg">
      <!-- Error Icon -->
      <div class="mb-6">
        <% if (statusCode === 500) { %>
          <svg class="w-24 h-24 mx-auto text-red-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        <% } else if (statusCode === 403) { %>
          <svg class="w-24 h-24 mx-auto text-yellow-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        <% } else if (statusCode === 404) { %>
          <svg class="w-24 h-24 mx-auto text-indigo-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        <% } else { %>
          <svg class="w-24 h-24 mx-auto text-zinc-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        <% } %>
        
        <h1 class="text-7xl font-bold <%= statusCode === 500 ? 'text-red-500' : statusCode === 403 ? 'text-yellow-500' : statusCode === 404 ? 'text-indigo-500' : 'text-zinc-500' %> mb-2">
          <%= statusCode %>
        </h1>
      </div>

      <h2 class="text-2xl font-semibold mb-3">
        <% if (statusCode === 500) { %>
          Like, zoinks! Something went wrong!
        <% } else if (statusCode === 403) { %>
          Ruh-roh! Access Denied!
        <% } else if (statusCode === 404) { %>
          Like, zoinks! Page not found!
        <% } else { %>
          Something went wrong!
        <% } %>
      </h2>

      <p class="text-zinc-400 mb-8"><%= message %></p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <button onclick="window.history.back()" class="bg-zinc-800 hover:bg-zinc-700 px-6 py-3 rounded-lg font-semibold transition inline-flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Go Back
        </button>
        <a href="/dashboard" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-3 rounded-lg font-semibold transition inline-flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          Dashboard
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/scripts/auth-check') %>
</body>
</html>
