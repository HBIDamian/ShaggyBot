<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title }) %>
</head>
<body class="bg-zinc-950 text-white min-h-screen guild-page">
  <%- include('partials/background') %>
  <%- include('partials/navbar', { requiresAuth: true, activePage: 'dashboard' }) %>

  <div class="flex min-h-[calc(100vh-65px)] relative z-10">
    <%- include('partials/sidebar', { activeSection: 'automod' }) %>

    <!-- Main Content -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto lg:ml-72">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6 md:mb-8">
          <h1 class="text-xl md:text-2xl font-bold mb-2">Auto-Moderation</h1>
          <p class="text-zinc-400 text-sm md:text-base">Configure automatic moderation rules for your server.</p>
        </div>

        <form id="automodForm" class="space-y-6">
          <!-- Master Toggle -->
          <div class="bg-indigo-600/20 border border-indigo-500 p-6 rounded-xl">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="font-semibold text-lg">Enable Auto-Moderation</h3>
                <p class="text-sm text-zinc-400">Master switch for all auto-moderation features</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="enabled" class="sr-only peer">
                <div class="w-14 h-7 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-indigo-600"></div>
              </label>
            </div>
          </div>

          <!-- General Settings -->
          <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 space-y-4">
            <div>
              <h3 class="font-semibold text-lg mb-1">⚙️ General Settings</h3>
              <p class="text-sm text-zinc-400">Configure log channel and exemptions</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-2">Log Channel</label>
                <select id="log_channel" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2 focus:outline-none focus:border-indigo-500">
                  <option value="">None (No Logging)</option>
                </select>
                <p class="text-xs text-zinc-500 mt-1">Channel to log automod actions</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-zinc-800">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" id="exclude_admins" class="sr-only peer">
                <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative"></div>
                <span class="text-sm">Exclude Admins</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" id="exclude_mods" class="sr-only peer">
                <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative"></div>
                <span class="text-sm">Exclude Mods</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" id="exclude_bots" class="sr-only peer">
                <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative"></div>
                <span class="text-sm">Exclude Bots</span>
              </label>
            </div>

            <div>
              <label class="block text-sm font-medium mb-2">Ignored Roles</label>
              <select id="exempt_roles" multiple data-placeholder="Select roles to ignore...">
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium mb-2">Ignored Channels</label>
              <select id="exempt_channels" multiple data-placeholder="Select channels to ignore...">
              </select>
            </div>
          </div>

          <!-- Moderation Features Grid -->
          <h3 class="text-lg font-semibold mt-8 mb-4">Message Moderation</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <!-- Word Blacklist -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">🤬</span>
                  <h4 class="font-medium">Word Blacklist</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="bad_words_enabled" class="sr-only peer feature-toggle" data-settings="badWordsSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block messages containing prohibited words</p>
              <div id="badWordsSettings" class="space-y-3 hidden">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="bad_words_use_default" class="rounded bg-zinc-700 border-zinc-600 text-indigo-600 focus:ring-indigo-500">
                  <span class="text-sm">Use default word list</span>
                </label>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Custom Words</label>
                  <textarea id="bad_words_list" rows="2" placeholder="word1, word2, word3"
                            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 resize-none"></textarea>
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="bad_words_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Mass Capitalization -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">🔠</span>
                  <h4 class="font-medium">Mass Capitalization</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="caps_enabled" class="sr-only peer feature-toggle" data-settings="capsSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Prevent excessive capital letters</p>
              <div id="capsSettings" class="space-y-3 hidden">
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-xs font-medium mb-1 text-zinc-400">Min Characters</label>
                    <input type="number" id="caps_min_chars" min="4" max="50" value="8"
                           class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                  </div>
                  <div>
                    <label class="block text-xs font-medium mb-1 text-zinc-400">Threshold %</label>
                    <input type="number" id="caps_percentage" min="50" max="100" value="70"
                           class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="caps_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Duplicate Characters -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">🔁</span>
                  <h4 class="font-medium">Duplicate Characters</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="duplicate_chars_enabled" class="sr-only peer feature-toggle" data-settings="duplicateCharsSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block repeated characters (e.g., "hellooooooo")</p>
              <div id="duplicateCharsSettings" class="space-y-3 hidden">
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-xs font-medium mb-1 text-zinc-400">Min Repeats</label>
                    <input type="number" id="duplicate_chars_min" min="3" max="20" value="4"
                           class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                  </div>
                  <div>
                    <label class="block text-xs font-medium mb-1 text-zinc-400">Threshold %</label>
                    <input type="number" id="duplicate_chars_percentage" min="30" max="100" value="75"
                           class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="duplicate_chars_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Duplicate Words -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">📝</span>
                  <h4 class="font-medium">Duplicate Words</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="duplicate_words_enabled" class="sr-only peer feature-toggle" data-settings="duplicateWordsSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block repeated words (e.g., "hey hey hey hey")</p>
              <div id="duplicateWordsSettings" class="space-y-3 hidden">
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Min Repeated Words</label>
                  <input type="number" id="duplicate_words_count" min="3" max="20" value="5"
                         class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="duplicate_words_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Mass Mentions -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">📢</span>
                  <h4 class="font-medium">Mass Mentions</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="mass_mentions_enabled" class="sr-only peer feature-toggle" data-settings="massMentionsSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Prevent mass mentioning users</p>
              <div id="massMentionsSettings" class="space-y-3 hidden">
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Max Mentions</label>
                  <input type="number" id="mass_mentions_count" min="2" max="20" value="5"
                         class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="mass_mentions_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Mass Emoji -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">😀</span>
                  <h4 class="font-medium">Mass Emoji</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="mass_emoji_enabled" class="sr-only peer feature-toggle" data-settings="massEmojiSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block excessive emoji usage</p>
              <div id="massEmojiSettings" class="space-y-3 hidden">
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Max Emojis</label>
                  <input type="number" id="mass_emoji_count" min="3" max="50" value="5"
                         class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="mass_emoji_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Spoilers -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">🙈</span>
                  <h4 class="font-medium">Spoilers</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="spoilers_enabled" class="sr-only peer feature-toggle" data-settings="spoilersSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block spoiler-tagged content</p>
              <div id="spoilersSettings" class="space-y-3 hidden">
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Min Characters</label>
                  <input type="number" id="spoilers_min_chars" min="1" max="100" value="4"
                         class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="spoilers_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Discord Invites -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">📨</span>
                  <h4 class="font-medium">Discord Invites</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="invites_enabled" class="sr-only peer feature-toggle" data-settings="invitesSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block Discord server invite links</p>
              <div id="invitesSettings" class="space-y-3 hidden">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="invites_ignore_partners" class="rounded bg-zinc-700 border-zinc-600 text-indigo-600 focus:ring-indigo-500">
                  <span class="text-sm">Ignore Partner Servers</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="invites_ignore_verified" class="rounded bg-zinc-700 border-zinc-600 text-indigo-600 focus:ring-indigo-500">
                  <span class="text-sm">Ignore Verified Servers</span>
                </label>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Punishment</label>
                  <select id="invites_action" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500">
                    <option value="delete">Delete Message</option>
                    <option value="delete_warn">Delete & Warn User</option>
                    <option value="delete_timeout">Delete & Timeout User (1h)</option>
                    <option value="warn">Warn User</option>
                    <option value="delete_kick">Delete Message & Kick User</option>
                    <option value="delete_kick_warn">Delete & Kick + Warn User</option>
                    <option value="ban">Ban User (Delete 24h)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Website URLs -->
            <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-lg">🔗</span>
                  <h4 class="font-medium">Website URLs</h4>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="links_enabled" class="sr-only peer feature-toggle" data-settings="linksSettings">
                  <div class="w-11 h-6 bg-zinc-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
              </div>
              <p class="text-xs text-zinc-500 mb-3">Block or whitelist website links</p>
              <div id="linksSettings" class="space-y-3 hidden">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="links_whitelist_mode" class="rounded bg-zinc-700 border-zinc-600 text-indigo-600 focus:ring-indigo-500">
                  <span class="text-sm">Whitelist Mode (only allow listed)</span>
                </label>
                <div>
                  <label class="block text-xs font-medium mb-1 text-zinc-400">Allowed Domains</label>
                  <textarea id="links_whitelist" rows="2" placeholder="discord.com, youtube.com"
                            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 resize-none"></textarea>
                </div>
                <div>
