  <script>
    function onGuildReady(data) {
      document.title = `Auto-Mod - ${data.name} - ShaggyBot`;

      // Populate log channel
      const logChannelSelect = document.getElementById('log_channel');
      data.channels.forEach(channel => {
        const option = document.createElement('option');
        option.value = channel.id;
        option.textContent = `#${channel.name}`;
        logChannelSelect.appendChild(option);
      });

      // Populate exempt roles
      const roleSelect = document.getElementById('exempt_roles');
      data.roles.forEach(role => {
        const option = document.createElement('option');
        option.value = role.id;
        option.textContent = `@${role.name}`;
        roleSelect.appendChild(option);
      });

      // Populate exempt channels
      const channelSelect = document.getElementById('exempt_channels');
      data.channels.forEach(channel => {
        const option = document.createElement('option');
        option.value = channel.id;
        option.textContent = `#${channel.name}`;
        channelSelect.appendChild(option);
      });

      initMultiSelects();
      loadSettings();
    }

    function setMultiSelect(id, values) {
      const select = document.getElementById(id);
      if (!select) return;
      if (select.multiSelect) {
        select.multiSelect.setValues(values || []);
      } else {
        Array.from(select.options).forEach(opt => opt.selected = (values || []).includes(opt.value));
      }
    }

    function getMultiSelect(id) {
      const select = document.getElementById(id);
      if (!select) return [];
      if (select.multiSelect) {
        return select.multiSelect.getValues();
      }
      return Array.from(select.selectedOptions).map(o => o.value);
    }

    function updateFileExtModeLabel() {
      const isWhitelist = document.getElementById('file_extensions_whitelist_mode').checked;
      document.getElementById('file_ext_mode_label').textContent = isWhitelist ? 'Whitelist Mode' : 'Blacklist Mode';
      document.getElementById('file_ext_mode_desc').textContent = isWhitelist ? 'Only allow files with these extensions' : 'Block files with these extensions';
      document.getElementById('file_ext_list_label').textContent = isWhitelist ? 'Allowed Extensions' : 'Blocked Extensions';
    }

    function loadSettings() {
      fetch(`/api/guilds/${guildId}/automod`).then(res => res.json()).then(settings => {
        // Master toggle
        document.getElementById('enabled').checked = settings.enabled;
        
        // General settings
        document.getElementById('log_channel').value = settings.log_channel || '';
        document.getElementById('exclude_admins').checked = settings.exclude_admins;
        document.getElementById('exclude_mods').checked = settings.exclude_mods;
        document.getElementById('exclude_bots').checked = settings.exclude_bots;
        setMultiSelect('exempt_roles', settings.exempt_roles || []);
        setMultiSelect('exempt_channels', settings.exempt_channels || []);

        // Word Blacklist
        document.getElementById('bad_words_enabled').checked = settings.bad_words_enabled;
        document.getElementById('bad_words_use_default').checked = settings.bad_words_use_default;
        document.getElementById('bad_words_list').value = (settings.bad_words_list || []).join(', ');
        document.getElementById('bad_words_action').value = settings.bad_words_action || 'delete';

        // Mass Caps
        document.getElementById('caps_enabled').checked = settings.caps_enabled;
        document.getElementById('caps_min_chars').value = settings.caps_min_chars || 8;
        document.getElementById('caps_percentage').value = settings.caps_percentage || 70;
        document.getElementById('caps_action').value = settings.caps_action || 'delete';

        // Duplicate Characters
        document.getElementById('duplicate_chars_enabled').checked = settings.duplicate_chars_enabled;
        document.getElementById('duplicate_chars_min').value = settings.duplicate_chars_min || 4;
        document.getElementById('duplicate_chars_percentage').value = settings.duplicate_chars_percentage || 75;
        document.getElementById('duplicate_chars_action').value = settings.duplicate_chars_action || 'delete';

        // Duplicate Words
        document.getElementById('duplicate_words_enabled').checked = settings.duplicate_words_enabled;
        document.getElementById('duplicate_words_count').value = settings.duplicate_words_count || 5;
        document.getElementById('duplicate_words_action').value = settings.duplicate_words_action || 'delete';

        // Mass Mentions
        document.getElementById('mass_mentions_enabled').checked = settings.mass_mentions_enabled;
        document.getElementById('mass_mentions_count').value = settings.mass_mentions_count || 5;
        document.getElementById('mass_mentions_action').value = settings.mass_mentions_action || 'delete_warn';

        // Mass Emoji
        document.getElementById('mass_emoji_enabled').checked = settings.mass_emoji_enabled;
        document.getElementById('mass_emoji_count').value = settings.mass_emoji_count || 5;
        document.getElementById('mass_emoji_action').value = settings.mass_emoji_action || 'delete';

        // Spoilers
        document.getElementById('spoilers_enabled').checked = settings.spoilers_enabled;
        document.getElementById('spoilers_min_chars').value = settings.spoilers_min_chars || 4;
        document.getElementById('spoilers_action').value = settings.spoilers_action || 'delete';

        // Discord Invites
        document.getElementById('invites_enabled').checked = settings.invites_enabled;
        document.getElementById('invites_ignore_partners').checked = settings.invites_ignore_partners;
        document.getElementById('invites_ignore_verified').checked = settings.invites_ignore_verified;
        document.getElementById('invites_action').value = settings.invites_action || 'delete_warn';

        // Website URLs
        document.getElementById('links_enabled').checked = settings.links_enabled;
        document.getElementById('links_whitelist_mode').checked = settings.links_whitelist_mode;
        document.getElementById('links_whitelist').value = (settings.links_whitelist || []).join(', ');
        document.getElementById('links_action').value = settings.links_action || 'delete';

        // File Extensions
        document.getElementById('file_extensions_enabled').checked = settings.file_extensions_enabled;
        document.getElementById('file_extensions_whitelist_mode').checked = settings.file_extensions_whitelist_mode;
        document.getElementById('file_extensions_list').value = (settings.file_extensions_list || []).join(', ');
        document.getElementById('file_extensions_action').value = settings.file_extensions_action || 'delete';
        updateFileExtModeLabel();

        // Stickers
        document.getElementById('stickers_enabled').checked = settings.stickers_enabled;
        document.getElementById('stickers_action').value = settings.stickers_action || 'delete';

        // Zalgo
        document.getElementById('zalgo_enabled').checked = settings.zalgo_enabled;
        document.getElementById('zalgo_action').value = settings.zalgo_action || 'delete';

        // Phishing
        document.getElementById('phishing_enabled').checked = settings.phishing_enabled;
        document.getElementById('phishing_action').value = settings.phishing_action || 'ban';

        // Phone Numbers
        document.getElementById('phone_numbers_enabled').checked = settings.phone_numbers_enabled;
        document.getElementById('phone_numbers_action').value = settings.phone_numbers_action || 'delete_warn';

        // Markdown Headers
        document.getElementById('markdown_headers_enabled').checked = settings.markdown_headers_enabled;
        document.getElementById('markdown_headers_action').value = settings.markdown_headers_action || 'delete';

        // Anti-Spam
        document.getElementById('spam_enabled').checked = settings.spam_enabled;
        document.getElementById('spam_threshold').value = settings.spam_threshold || 5;
        document.getElementById('spam_interval').value = settings.spam_interval || 5000;
        document.getElementById('spam_action').value = settings.spam_action || 'mute';

        // Dehoist
        document.getElementById('dehoist_enabled').checked = settings.dehoist_enabled;

        updateSubsettingsVisibility();
      });
    }

    function updateSubsettingsVisibility() {
      document.querySelectorAll('.feature-toggle').forEach(toggle => {
        const settingsId = toggle.dataset.settings;
        if (settingsId) {
          const settings = document.getElementById(settingsId);
          if (settings) {
            settings.classList.toggle('hidden', !toggle.checked);
          }
        }
      });
    }

    document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.addEventListener('change', updateSubsettingsVisibility));

    document.getElementById('automodForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const data = {
        enabled: document.getElementById('enabled').checked ? 1 : 0,
        log_channel: document.getElementById('log_channel').value || null,
        exclude_admins: document.getElementById('exclude_admins').checked ? 1 : 0,
        exclude_mods: document.getElementById('exclude_mods').checked ? 1 : 0,
        exclude_bots: document.getElementById('exclude_bots').checked ? 1 : 0,
        exempt_roles: getMultiSelect('exempt_roles'),
        exempt_channels: getMultiSelect('exempt_channels'),

        // Word Blacklist
        bad_words_enabled: document.getElementById('bad_words_enabled').checked ? 1 : 0,
        bad_words_use_default: document.getElementById('bad_words_use_default').checked ? 1 : 0,
        bad_words_list: document.getElementById('bad_words_list').value.split(',').map(w => w.trim().toLowerCase()).filter(w => w.length > 0),
        bad_words_action: document.getElementById('bad_words_action').value,

        // Mass Caps
        caps_enabled: document.getElementById('caps_enabled').checked ? 1 : 0,
        caps_min_chars: parseInt(document.getElementById('caps_min_chars').value),
        caps_percentage: parseInt(document.getElementById('caps_percentage').value),
        caps_action: document.getElementById('caps_action').value,

        // Duplicate Characters
        duplicate_chars_enabled: document.getElementById('duplicate_chars_enabled').checked ? 1 : 0,
        duplicate_chars_min: parseInt(document.getElementById('duplicate_chars_min').value),
        duplicate_chars_percentage: parseInt(document.getElementById('duplicate_chars_percentage').value),
        duplicate_chars_action: document.getElementById('duplicate_chars_action').value,

        // Duplicate Words
        duplicate_words_enabled: document.getElementById('duplicate_words_enabled').checked ? 1 : 0,
        duplicate_words_count: parseInt(document.getElementById('duplicate_words_count').value),
        duplicate_words_action: document.getElementById('duplicate_words_action').value,

        // Mass Mentions
        mass_mentions_enabled: document.getElementById('mass_mentions_enabled').checked ? 1 : 0,
        mass_mentions_count: parseInt(document.getElementById('mass_mentions_count').value),
        mass_mentions_action: document.getElementById('mass_mentions_action').value,

        // Mass Emoji
        mass_emoji_enabled: document.getElementById('mass_emoji_enabled').checked ? 1 : 0,
        mass_emoji_count: parseInt(document.getElementById('mass_emoji_count').value),
        mass_emoji_action: document.getElementById('mass_emoji_action').value,

        // Spoilers
        spoilers_enabled: document.getElementById('spoilers_enabled').checked ? 1 : 0,
        spoilers_min_chars: parseInt(document.getElementById('spoilers_min_chars').value),
        spoilers_action: document.getElementById('spoilers_action').value,

        // Discord Invites
        invites_enabled: document.getElementById('invites_enabled').checked ? 1 : 0,
        invites_ignore_partners: document.getElementById('invites_ignore_partners').checked ? 1 : 0,
        invites_ignore_verified: document.getElementById('invites_ignore_verified').checked ? 1 : 0,
        invites_action: document.getElementById('invites_action').value,

        // Website URLs
        links_enabled: document.getElementById('links_enabled').checked ? 1 : 0,
        links_whitelist_mode: document.getElementById('links_whitelist_mode').checked ? 1 : 0,
        links_whitelist: document.getElementById('links_whitelist').value.split(',').map(d => d.trim().toLowerCase()).filter(d => d.length > 0),
        links_action: document.getElementById('links_action').value,

        // File Extensions
        file_extensions_enabled: document.getElementById('file_extensions_enabled').checked ? 1 : 0,
        file_extensions_whitelist_mode: document.getElementById('file_extensions_whitelist_mode').checked ? 1 : 0,
        file_extensions_list: document.getElementById('file_extensions_list').value.split(',').map(e => e.trim().toLowerCase()).filter(e => e.length > 0),
        file_extensions_action: document.getElementById('file_extensions_action').value,

        // Stickers
        stickers_enabled: document.getElementById('stickers_enabled').checked ? 1 : 0,
        stickers_action: document.getElementById('stickers_action').value,

        // Zalgo
        zalgo_enabled: document.getElementById('zalgo_enabled').checked ? 1 : 0,
        zalgo_action: document.getElementById('zalgo_action').value,

        // Phishing
        phishing_enabled: document.getElementById('phishing_enabled').checked ? 1 : 0,
        phishing_action: document.getElementById('phishing_action').value,

        // Phone Numbers
        phone_numbers_enabled: document.getElementById('phone_numbers_enabled').checked ? 1 : 0,
        phone_numbers_action: document.getElementById('phone_numbers_action').value,

        // Markdown Headers
        markdown_headers_enabled: document.getElementById('markdown_headers_enabled').checked ? 1 : 0,
        markdown_headers_action: document.getElementById('markdown_headers_action').value,

        // Anti-Spam
        spam_enabled: document.getElementById('spam_enabled').checked ? 1 : 0,
        spam_threshold: parseInt(document.getElementById('spam_threshold').value),
        spam_interval: parseInt(document.getElementById('spam_interval').value),
        spam_action: document.getElementById('spam_action').value,

        // Dehoist
        dehoist_enabled: document.getElementById('dehoist_enabled').checked ? 1 : 0
      };

      const status = document.getElementById('saveStatus');
      status.textContent = 'Saving...';
      status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-zinc-800 text-zinc-400';

      try {
        const res = await fetch(`/api/guilds/${guildId}/automod`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (res.ok) {
          if (result._warning) {
            status.textContent = `⚠️ Settings saved with warnings: ${result._warning}`;
            status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-yellow-500/20 text-yellow-400';
            console.warn('Automod save warning:', result._warning);
          } else {
            status.textContent = '✓ Auto-mod settings saved successfully!';
            status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-green-500/20 text-green-400';
          }
        } else throw new Error(result.error || 'Failed');
      } catch (err) {
        status.textContent = '✗ Failed to save settings. Please try again.';
        status.className = 'mt-4 px-4 py-3 rounded-lg text-sm bg-red-500/20 text-red-400';
        console.error('Automod save error:', err);
      }
      setTimeout(() => { status.className = 'mt-4 px-4 py-3 rounded-lg text-sm hidden'; }, 4000);
    });
  </script>
  <%- include('partials/scripts/guild-loader') %>
  <%- include('partials/scripts/multi-select') %>
</body>
</html>
