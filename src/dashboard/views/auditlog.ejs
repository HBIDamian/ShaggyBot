      'server_modified_color',
      'role_created_color', 'role_deleted_color', 'role_modified_color',
      'channel_created_color', 'channel_deleted_color', 'channel_modified_color',
      'invite_created_color', 'invite_deleted_color',
      'thread_created_color', 'thread_deleted_color', 'thread_modified_color',
      'stage_started_color', 'stage_ended_color', 'stage_modified_color',
      'bot_added_color',
      'webhook_created_color', 'webhook_modified_color', 'webhook_deleted_color',
