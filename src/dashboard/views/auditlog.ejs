    function onGuildReady(data) {
      document.title = `${data.name} - Audit Log`;

      // Populate channel selects
      document.querySelectorAll('.channel-select').forEach(select => {
        const isMultiple = select.multiple;
        data.channels.forEach(channel => {
          const option = document.createElement('option');
          option.value = channel.id;
          option.textContent = `#${channel.name}`;
          select.appendChild(option);
        });
      });

      // Populate role selects
      document.querySelectorAll('.role-select').forEach(select => {
        data.roles.forEach(role => {
          const option = document.createElement('option');
          option.value = role.id;
          option.textContent = `@${role.name}`;
          select.appendChild(option);
        });
      });

      // Initialize multi-selects after options are populated
      initMultiSelects();

      loadSettings();
    }

