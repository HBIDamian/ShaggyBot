<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title }) %>
  <style>
    .color-preview {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      border: 2px solid rgba(255,255,255,0.1);
      cursor: pointer;
    }
    .color-input {
      opacity: 0;
      position: absolute;
      width: 32px;
      height: 32px;
      cursor: pointer;
    }
    .event-card {
      transition: all 0.2s ease;
    }
    .event-card:hover {
      border-color: rgba(99, 102, 241, 0.5);
    }
    .category-header {
      cursor: pointer;
      user-select: none;
    }
    .category-header:hover {
      background-color: rgba(255,255,255,0.03);
    }
    .category-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }
    .category-content.open {
      max-height: 2000px;
    }
    .chevron {
      transition: transform 0.2s ease;
    }
    .chevron.open {
      transform: rotate(180deg);
    }
  </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen guild-page">
  <%- include('partials/background') %>
  <%- include('partials/navbar', { requiresAuth: true, activePage: 'dashboard' }) %>

  <div class="flex min-h-[calc(100vh-65px)] relative z-10">
    <%- include('partials/sidebar', { activeSection: 'auditlog' }) %>

    <!-- Main Content -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto lg:ml-72">
      <div class="max-w-6xl mx-auto">
        <div class="mb-6 md:mb-8">
          <h1 class="text-xl md:text-2xl font-bold mb-2">Audit Log</h1>
          <p class="text-zinc-400 text-sm md:text-base">Configure which server events are logged and where they're sent.</p>
        </div>

        <!-- Master Toggle -->
        <div class="bg-indigo-600/20 border border-indigo-500 p-6 rounded-xl mb-6">
          <div class="flex justify-between items-center">
            <div>
              <h3 class="font-semibold text-lg">Enable Audit Logging</h3>
              <p class="text-sm text-zinc-400">Master switch for all audit log features</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="masterEnabled" class="sr-only peer">
              <div class="w-14 h-7 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-indigo-600"></div>
            </label>
          </div>
        </div>

        <!-- Global Settings -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 mb-6">
          <h3 class="font-semibold mb-4 flex items-center gap-2">
            <span class="text-xl">⚙️</span> Global Settings
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium mb-2">Ignored Roles</label>
              <select id="ignored_roles" multiple data-placeholder="Select roles to ignore..."
                      class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 focus:outline-none focus:border-indigo-500 transition min-h-[100px] role-select">
              </select>
              <p class="text-xs text-zinc-500 mt-1.5">Events from users with these roles won't be logged</p>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Ignored Channels</label>
              <select id="ignored_channels" multiple data-placeholder="Select channels to ignore..."
                      class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 focus:outline-none focus:border-indigo-500 transition min-h-[100px] channel-select">
              </select>
              <p class="text-xs text-zinc-500 mt-1.5">Events from these channels won't be logged</p>
            </div>
          </div>
          
          <!-- Batch Channel Setter -->
          <div class="mt-6 pt-6 border-t border-zinc-700">
            <h4 class="font-medium mb-3 flex items-center gap-2">
              <span>📢</span> Set All Log Channels
            </h4>
            <p class="text-sm text-zinc-400 mb-3">Quickly set all event log channels to a single channel at once.</p>
            <div class="flex flex-col sm:flex-row gap-3">
              <select id="batch_channel" class="flex-1 bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 focus:outline-none focus:border-indigo-500 transition channel-select">
                <option value="">Select a channel...</option>
              </select>
              <button onclick="showBatchConfirmDialog()" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2.5 rounded-lg font-medium transition flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Apply to All
              </button>
            </div>
          </div>
        </div>

        <!-- Batch Confirm Dialog -->
        <div id="batchConfirmDialog" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center">
          <div class="bg-zinc-900 border border-zinc-700 rounded-xl p-6 max-w-md w-full mx-4 shadow-2xl">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-full bg-yellow-500/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold">Are you sure?</h3>
                <p class="text-sm text-zinc-400">This action will overwrite all channel settings</p>
              </div>
            </div>
            <p class="text-zinc-300 mb-6" id="batchConfirmMessage">
              This will set all audit log event channels to the selected channel. Any previously configured channels will be replaced.
            </p>
            <div class="flex gap-3 justify-end">
              <button onclick="hideBatchConfirmDialog()" class="px-4 py-2 bg-zinc-700 hover:bg-zinc-600 rounded-lg font-medium transition">
                Cancel
              </button>
              <button onclick="applyBatchChannel()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 rounded-lg font-medium transition">
                Yes, Apply to All
              </button>
            </div>
          </div>
        </div>

        <!-- Categories -->
        <div class="space-y-4" id="categoriesContainer">
          
          <!-- User Events -->
          <div class="bg-zinc-900 rounded-xl border border-zinc-800 overflow-hidden">
            <div class="category-header p-4 flex items-center justify-between" onclick="toggleCategory('user')">
