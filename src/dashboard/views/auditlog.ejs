    function setCheckbox(id, value) {
      const el = document.getElementById(id);
      if (el) el.checked = value === 1 || value === true;
    }

    function setValue(id, value) {
      const el = document.getElementById(id);
      if (el) el.value = value || '';
    }

    function setColor(id, value) {
      const textInput = document.getElementById(id);
      const picker = document.getElementById(`${id}_picker`);
      const preview = document.getElementById(`${id}_preview`);
      
      if (value) {
        if (textInput) textInput.value = value;
        if (picker) picker.value = value;
        if (preview) preview.style.backgroundColor = value;
      }
    }

    function setMultiSelect(id, values) {
      const select = document.getElementById(id);
      if (!select) return;
      
      // Use the multi-select component if available
      if (select.multiSelect) {
        select.multiSelect.setValues(values || []);
      } else {
        // Fallback to native
        Array.from(select.options).forEach(option => {
          option.selected = values.includes(option.value);
        });
      }
    }

    function getMultiSelect(id) {
      const select = document.getElementById(id);
      if (!select) return [];
      
      // Use the multi-select component if available
      if (select.multiSelect) {
        return select.multiSelect.getValues();
      }
      return Array.from(select.selectedOptions).map(o => o.value);
    }

    async function saveSettings() {
      const data = {
        // Master toggle
