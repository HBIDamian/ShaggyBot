        channel_created_channel: document.getElementById('channel_created_channel').value,
        channel_created_color: document.getElementById('channel_created_color').value,
        channel_created_ignore_tickets: document.getElementById('channel_created_ignore_tickets').checked ? 1 : 0,
        channel_deleted_enabled: document.getElementById('channel_deleted_enabled').checked ? 1 : 0,
        channel_deleted_channel: document.getElementById('channel_deleted_channel').value,
        channel_deleted_color: document.getElementById('channel_deleted_color').value,
        channel_deleted_ignore_tickets: document.getElementById('channel_deleted_ignore_tickets').checked ? 1 : 0,
        channel_modified_enabled: document.getElementById('channel_modified_enabled').checked ? 1 : 0,
        channel_modified_channel: document.getElementById('channel_modified_channel').value,
        channel_modified_color: document.getElementById('channel_modified_color').value,

        // Invite events
        invite_created_enabled: document.getElementById('invite_created_enabled').checked ? 1 : 0,
        invite_created_channel: document.getElementById('invite_created_channel').value,
        invite_created_color: document.getElementById('invite_created_color').value,
        invite_deleted_enabled: document.getElementById('invite_deleted_enabled').checked ? 1 : 0,
        invite_deleted_channel: document.getElementById('invite_deleted_channel').value,
        invite_deleted_color: document.getElementById('invite_deleted_color').value,

        // Thread events
