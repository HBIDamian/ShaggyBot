                        <div class="relative">
                          <input type="color" id="message_modified_color_picker" value="#D93A00" class="color-input">
                          <div id="message_modified_color_preview" class="color-preview" style="background-color: #D93A00;"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Bulk Delete -->
                <div class="event-card bg-zinc-800 p-4 rounded-lg border border-zinc-700">
                  <h4 class="font-medium text-center mb-4">Bulk Delete Messages</h4>
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm">Enable Event</span>
                      <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="bulk_delete_enabled" class="sr-only peer">
                        <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                      </label>
                    </div>
                    <div>
                      <label class="block text-xs text-zinc-400 mb-1">Log Channel</label>
                      <select id="bulk_delete_channel" class="w-full bg-zinc-800 border border-zinc-700 rounded px-3 py-1.5 text-sm channel-select">
                        <option value="">None</option>
                      </select>
                    </div>
                    <div>
                      <label class="block text-xs text-zinc-400 mb-1">Color</label>
                      <div class="relative flex items-center gap-2">
                        <input type="text" id="bulk_delete_color" value="#FF0000" class="flex-1 bg-zinc-800 border border-zinc-700 rounded px-3 py-1.5 text-sm font-mono">
