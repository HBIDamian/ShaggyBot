                <span class="text-xl">👤</span> User Events
              </h3>
              <svg class="w-5 h-5 chevron" id="chevron-user" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
            <div class="category-content" id="category-user">
              <div class="p-4 pt-0 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- User Join -->
                <div class="event-card bg-zinc-800 p-4 rounded-lg border border-zinc-700">
                  <h4 class="font-medium text-center mb-4">User Join</h4>
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm">Enable Event</span>
                      <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="user_join_enabled" class="sr-only peer">
                        <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                      </label>
                    </div>
                    <div>
                      <label class="block text-xs text-zinc-400 mb-1">Log Channel</label>
                      <select id="user_join_channel" class="w-full bg-zinc-800 border border-zinc-700 rounded px-3 py-1.5 text-sm channel-select">
                        <option value="">None</option>
                      </select>
                    </div>
                    <div>
                      <label class="block text-xs text-zinc-400 mb-1">Color</label>
                      <div class="relative flex items-center gap-2">
                        <input type="text" id="user_join_color" value="#00FF00" class="flex-1 bg-zinc-800 border border-zinc-700 rounded px-3 py-1.5 text-sm font-mono">
                        <div class="relative">
                          <input type="color" id="user_join_color_picker" value="#00FF00" class="color-input">
                          <div id="user_join_color_preview" class="color-preview" style="background-color: #00FF00;"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- User Leave -->
