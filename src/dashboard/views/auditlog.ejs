      const content = document.getElementById(`category-${category}`);
      const chevron = document.getElementById(`chevron-${category}`);
      content.classList.toggle('open');
      chevron.classList.toggle('open');
    }

    // Batch channel functions
    function showBatchConfirmDialog() {
      const batchChannel = document.getElementById('batch_channel').value;
      if (!batchChannel) {
        showToast('Please select a channel first', 'error');
        return;
      }
      
      const channelName = document.getElementById('batch_channel').selectedOptions[0]?.textContent || 'selected channel';
      document.getElementById('batchConfirmMessage').innerHTML = 
        `This will set <strong>all</strong> audit log event channels to <strong>${channelName}</strong>. Any previously configured channels will be replaced.`;
      
      document.getElementById('batchConfirmDialog').classList.remove('hidden');
      document.getElementById('batchConfirmDialog').classList.add('flex');
    }

    function hideBatchConfirmDialog() {
      document.getElementById('batchConfirmDialog').classList.add('hidden');
      document.getElementById('batchConfirmDialog').classList.remove('flex');
    }

    function applyBatchChannel() {
      const batchChannel = document.getElementById('batch_channel').value;
      
      // List of all channel select IDs (excluding the batch selector itself and ignored_channels)
      const channelSelectIds = [
        'user_join_channel', 'user_leave_channel', 'user_banned_channel', 'user_modified_channel',
        'message_deleted_channel', 'message_modified_channel', 'bulk_delete_channel',
        'voice_join_channel', 'voice_swap_channel', 'voice_leave_channel',
        'server_modified_channel',
        'role_created_channel', 'role_deleted_channel', 'role_modified_channel',
        'channel_created_channel', 'channel_deleted_channel', 'channel_modified_channel',
        'invite_created_channel', 'invite_deleted_channel',
        'thread_created_channel', 'thread_deleted_channel', 'thread_modified_channel',
        'stage_started_channel', 'stage_ended_channel', 'stage_modified_channel',
        'bot_added_channel',
        'webhook_created_channel', 'webhook_modified_channel', 'webhook_deleted_channel',
        'monitored_roles_channel'
      ];

      // Set all channel selects to the batch value
      channelSelectIds.forEach(id => {
        const select = document.getElementById(id);
        if (select) {
          select.value = batchChannel;
        }
      });

      hideBatchConfirmDialog();
      showToast('All log channels have been updated! Don\'t forget to save.', 'success');
    }

    // Close dialog on outside click
    document.getElementById('batchConfirmDialog')?.addEventListener('click', function(e) {
      if (e.target === this) {
        hideBatchConfirmDialog();
      }
    });

    // Color picker sync
    function setupColorPicker(baseId) {
      const textInput = document.getElementById(baseId);
      const colorPicker = document.getElementById(`${baseId}_picker`);
      const preview = document.getElementById(`${baseId}_preview`);
      
      if (!textInput || !colorPicker || !preview) return;

      textInput.addEventListener('input', () => {
        const color = textInput.value;
        if (/^#[0-9A-Fa-f]{6}$/.test(color)) {
          colorPicker.value = color;
          preview.style.backgroundColor = color;
        }
      });

      colorPicker.addEventListener('input', () => {
        textInput.value = colorPicker.value.toUpperCase();
        preview.style.backgroundColor = colorPicker.value;
      });
    }

    // Initialize all color pickers
