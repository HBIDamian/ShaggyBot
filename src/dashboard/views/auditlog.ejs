        user_join_channel: document.getElementById('user_join_channel').value,
        user_join_color: document.getElementById('user_join_color').value,
        user_leave_enabled: document.getElementById('user_leave_enabled').checked ? 1 : 0,
        user_leave_channel: document.getElementById('user_leave_channel').value,
        user_leave_color: document.getElementById('user_leave_color').value,
        user_banned_enabled: document.getElementById('user_banned_enabled').checked ? 1 : 0,
        user_banned_channel: document.getElementById('user_banned_channel').value,
        user_banned_color: document.getElementById('user_banned_color').value,
        user_modified_enabled: document.getElementById('user_modified_enabled').checked ? 1 : 0,
        user_modified_channel: document.getElementById('user_modified_channel').value,
